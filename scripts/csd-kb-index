#!/usr/bin/env bash
# CUDA reindex of akula-csd-kb on gpu5080 exclusive-seq. Never pause LocalAI on the 3090.
set -euo pipefail
AKULA="${AKULA_ROOT:-/home/kang/code/personal/tzervas/akula-ai-platform}"
VAULT="${CSD_VAULT:-/akula-data/obsidian/akula-csd-kb}"
COLL="${CSD_COLLECTION:-akula-csd-kb}"
OP_VAULT="/home/kang/data/obsidian/tzervas-dev-kb/tzervas-dev-kb"
RAG_PY="$OP_VAULT/_meta/services/rag/.venv/bin/python"
IDX="$OP_VAULT/_meta/tools/index_vault_qdrant.py"
if [[ ! -x "$RAG_PY" ]]; then
  echo "missing RAG venv $RAG_PY" >&2
  exit 2
fi
mkdir -p "$VAULT"
export AKULA_GPU_KIND=index
echo "csd-kb-index: vault=$VAULT collection=$COLL (5080 exclusive if gpu-alloc says so)" >&2
exec "$AKULA/scripts/with-gpu-rag" -- "$RAG_PY" -u "$IDX" --vault "$VAULT" --collection "$COLL"
