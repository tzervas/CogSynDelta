LOCALAI = os.environ.get("LOCALAI_URL", "http://127.0.0.1:8080")
GPU5080 = os.environ.get("GPU5080_SSH", "gpu5080")
ROUTER_STATE = Path(os.environ.get("CSD_ROUTER_STATE", "/akula-data/cabal/model-router-state.json"))
QUEUE_DIR = Path(os.environ.get("CSD_LOCALAI_QUEUE", "/akula-data/cabal/localai-queue"))
AUTODEV_OUT = Path("/akula-data/cabal/autodev-out")
GPU_PLAN = Path(os.environ.get("CSD_GPU_PLAN", "/akula-data/cabal/gpu-plan.json"))
SESS_DIR = Path(os.environ.get("CSD_LAB_SESSIONS", "/akula-data/cabal/lab-sessions"))
UPSTREAM = os.environ.get("CSD_UPSTREAM", "").rstrip("/")
# Minted server-side at process start (secret exec), never taken from a client
# header. Attached by proxy_upstream() for allowlisted routes only; never
# forwarded for /api/apply, which never proxies (see PROXY_ALLOW).
UPSTREAM_TOKEN = os.environ.get("CSD_UPSTREAM_TOKEN", "").strip()
# Default-deny: only these read-only, non-credentialed routes may be relayed
# to UPSTREAM. /api/apply is never eligible -- see dispatch_api_post, which
# handles it locally before this allowlist is even consulted -- and the
# exclusion is repeated in proxy_eligible() as an independent second guard.
PROXY_ALLOW = frozenset(
    {
        "/api/status",
        "/api/gpu",
        "/api/sessions",
        "/api/comfy/list-workflows",
        "/api/comfy/prompt-status",
    }
)
APPLY_TOKEN_FILE = Path(os.environ.get("CSD_APPLY_TOKEN_FILE", "/akula-data/cabal/csd-apply.token"))
WORKTREES = {
    "p1-08": Path("/home/kang/code/personal/tzervas/python-ai/memory-gate-wt-p1-08"),
    "p1-07": Path("/home/kang/code/personal/tzervas/python-ai/memory-gate-wt-p1-07"),
}
PROTECTED_WT = Path("/home/kang/code/personal/tzervas/python-ai/memory-gate")
ALLOW_PREFIXES = ("src/", "tests/", "docs/")
ROOT = Path(__file__).resolve().parents[1]
GOALS = ROOT / "docs/program/GOALS.md"
ROUTER_JSON = ROOT / "config/model-router.json"
SCRIPTS = ROOT / "scripts"
SECRET_BIN = os.environ.get("CSD_SECRET_BIN", "/home/kang/.local/bin/secret")
