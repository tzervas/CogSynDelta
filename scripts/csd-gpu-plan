#!/usr/bin/env python3
"""Plan 3090/5080 splits for autodev. Never dual 14B. Never OOM on purpose."""
# ruff: noqa: S607
from __future__ import annotations

import json
import os
import subprocess
from pathlib import Path

OUT = Path(os.environ.get("CSD_GPU_PLAN", "/akula-data/cabal/gpu-plan.json"))


def comfy_lab_field(enabled: str, wrap_ready: bool) -> str:
    """Map systemd is-enabled + lock wrap to the lab comfy field.

    Args:
        enabled: ``systemctl is-enabled`` stdout (generated/enabled/masked).
        wrap_ready: True when ExecStart drop-in is ``akula-comfyui-locked``.

    Returns:
        ``masked``, ``wrapped``, or the raw enabled string.

    Why: Quadlets report ``generated``. Mask is not the scheduler once the
    gpu5080-lock wrap is live. Operator mask still wins if systemd is masked.
    """
    raw = (enabled or "").strip()
    low = raw.lower()
    if "masked" in low:
        return "masked"
    if wrap_ready:
        return "wrapped"
    return raw or "unknown"


def helper_ok_5080(free_mib: int, comfy: str, lock: str) -> bool:
    """Share-small only when lock idle and Comfy is not free-running CUDA.

    Args:
        free_mib: nvidia-smi free MiB on the 5080.
        comfy: Lab comfy field (``masked`` / ``wrapped`` / raw systemd).
        lock: fuser / ``lock=idle`` text.

    Returns:
        True when leftover VRAM may hold a helper.

    Why: wrapped idle HTTP does not hold the 5080; masked also does not.
    Enabled without wrap is free-running CUDA — refuse helpers.
    """
    cf = (comfy or "").lower()
    return (
        free_mib >= 6144
        and ("masked" in cf or cf == "wrapped")
        and "idle" in (lock or "").lower()
    )


def parse_5080_aux(lines: list[str]) -> tuple[str, str, int]:
    """Parse is-enabled / wrap / lock / gguf lines after nvidia-smi.

    Args:
        lines: SSH stdout lines after the smi CSV row.

    Returns:
        Tuple of lab comfy field, lock text, and GGUF count.

    Why: live SSH grew a wrap-ready line; old 3-line blobs still parse.
    """
    enabled = lines[0] if lines else ""
    rest = list(lines[1:])
    wrap_ready = False
    if rest and rest[0].lower().startswith("wrap"):
        wrap_ready = "ready" in rest[0].lower() and "missing" not in rest[0].lower()
        rest = rest[1:]
    lock = rest[0] if rest else "?"
    gguf_raw = rest[1] if len(rest) > 1 else "0"
    try:
        gguf_count = int(gguf_raw.strip() or "0")
    except ValueError:
        gguf_count = 0
    return comfy_lab_field(enabled, wrap_ready), lock, gguf_count


def smi_local() -> dict:
    p = subprocess.run(
        [
            "nvidia-smi",
            "--query-gpu=name,memory.used,memory.free,memory.total",
            "--format=csv,noheader,nounits",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    parts = [x.strip() for x in (p.stdout or "").split(",")]
    if len(parts) < 4:
        return {"error": p.stderr[:200]}
    used, free, total = (int(float(parts[i])) for i in (1, 2, 3))
    return {
        "name": parts[0],
        "used_mib": used,
        "free_mib": free,
        "total_mib": total,
        "role": "local/code",
        "arch": "ampere",
        "sm": "8.6",
        "caps": [
            "gguf-infer",
            "high-vram",
            "localai",
            "ampere",
            "sm_86",
            "fp16",
            "decode-tight",
        ],
        "second_14b": False,
        "share_small": free >= 4096,
        "share_small_job": "embed-0.6B" if free >= 4096 else None,
    }


def smi_5080() -> dict:
    p = subprocess.run(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=8",
            "gpu5080",
            "nvidia-smi --query-gpu=name,memory.used,memory.free,memory.total "
            "--format=csv,noheader,nounits; "
            "systemctl is-enabled akula-comfyui.service 2>/dev/null || echo unknown; "
            "grep -qs akula-comfyui-locked "
            "/etc/systemd/system/akula-comfyui.service.d/gpu5080-lock.conf "
            "&& echo wrap-ready || echo wrap-missing; "
            "fuser /home/tzervas/akula-harness/state/gpu5080.lock 2>/dev/null || echo lock=idle; "
            "ls /models/localai/*.gguf 2>/dev/null | wc -l",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    lines = (p.stdout or "").strip().splitlines()
    parts = [x.strip() for x in (lines[0].split(",") if lines else [])]
    if len(parts) < 4:
        return {"error": (p.stderr or p.stdout)[:200]}
    used, free, total = (int(float(parts[i])) for i in (1, 2, 3))
    comfy, lock, gguf_count = parse_5080_aux(lines[1:])
    helper = helper_ok_5080(free, comfy, lock)
    return {
        "name": parts[0],
        "used_mib": used,
        "free_mib": free,
        "total_mib": total,
        "comfy": comfy,
        "lock": lock,
        "gguf_count": gguf_count,
        "arch": "blackwell",
        "sm": "12.0",
        "caps": ["cuda-eval", "sm_120", "fp8", "fp4", "embed", "gpu-ci", "blackwell"],
        "role": "cuda-tests" if not helper else "cuda-or-helper",
        "helper_ok": helper,
        "helper": "Qwen3-Embedding-0.6B in Comfy python3.13" if helper else None,
        "never": ["second 14B", "mask Comfy to schedule", "0.0.0.0 WAN"],
    }


def smi_1080ti() -> dict:
    """Guest Pascal RAG card. Never the 5080 lock."""
    p = subprocess.run(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=8",
            "gpu5080-1080ti",
            (
                "nvidia-smi --query-gpu=name,uuid,memory.used,memory.free,"
                "memory.total,power.limit --format=csv,noheader,nounits"
            ),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    parts = [x.strip() for x in (p.stdout or "").split(",")]
    if len(parts) < 6:
        return {"error": (p.stderr or p.stdout)[:200], "live": False}
    used, free, total = (int(float(parts[i])) for i in (2, 3, 4))
    return {
        "name": parts[0],
        "uuid": parts[1],
        "used_mib": used,
        "free_mib": free,
        "total_mib": total,
        "power_limit_w": parts[5],
        "arch": "pascal",
        "sm": "6.1",
        "role": "retrieve-index-light",
        "endpoint": "http://192.168.1.243",
        "live": True,
        "never": ["gpu5080.lock", "exclusive-seq", "PoC CUDA", "unmask Comfy"],
    }


def main() -> int:
    plan = {
        "autodev_priority": True,
        "akula-prime": smi_local(),
        "gpu5080": smi_5080(),
        "gpu5080-1080ti": smi_1080ti(),
        "webui_host": "homelab",
        "text_implementer": "local/code via csd-localai-queue",
        "hosted_grok": "plan/unblock/safety only",
        "pool": {
            "combined_mib": 39331,
            "usable_mib": 39331 - 1536,
            "enabled": False,
            "backend": "llama.cpp-rpc",
        },
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(plan, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
