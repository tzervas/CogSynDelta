def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--watch", action="store_true")
    ap.add_argument("--http", type=int, metavar="PORT")
    ap.add_argument("--chat")
    ap.add_argument("--steer", choices=["pause", "resume"])
    ap.add_argument("--steer-note")
    ap.add_argument("--steer-next")
    args = ap.parse_args()
    if args.steer:
        print(json.dumps(write_steer(pause=args.steer == "pause"), indent=2))
        return 0
    if args.steer_note is not None:
        print(json.dumps(write_steer(note=args.steer_note), indent=2))
        return 0
    if args.steer_next is not None:
        print(json.dumps(write_steer(next_goal=args.steer_next), indent=2))
        return 0
    if args.chat:
        print(chat(args.chat))
        return 0
    if args.http:
        serve(args.http)
        return 0
    if args.watch:
        while True:
            print("\033[2J\033[H", end="")
            print_snap(snapshot())
            time.sleep(5)
    print_snap(snapshot())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
