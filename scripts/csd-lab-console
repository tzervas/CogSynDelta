const BASE=location.pathname.indexOf('/lab')===0?'/lab':'';
function tab(id){
  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on', p.id===id));
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on', b.dataset.tab===id));
}
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{tab(b.dataset.tab); if(b.dataset.tab==='hist') loadHist(); if(b.dataset.tab==='todos') loadGoals(); if(b.dataset.tab==='auto') refresh();});
function esc(s){return String(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
function splitThink(t){
  t=t||'';
  const m=/<think>([\\s\\S]*?)<\\/think>/i.exec(t);
  return {think:m?m[1].trim():'', out:t.replace(/<think>[\\s\\S]*?<\\/think>/gi,'').trim()};
}
function aliases(list){
  if(!list||!list.length) return '<span class=muted>none loaded</span>';
  return list.map(x=>'<span class=alias>'+esc(x.alias)+(x.physical===false?' (logical)':'')+'</span>').join(' ');
}
function card(title, node){
  const th=node.thinking||{};
  const bits=splitThink(th.text||th.prompt||'');
  const think = bits.think ? '<h3>thinking</h3><pre>'+esc(bits.think)+'</pre>' : '';
  const body = bits.out ? '<h3>'+esc(th.phase||'activity')+'</h3><pre>'+esc(bits.out)+'</pre>' : (th.prompt?'<h3>in-flight</h3><pre>'+esc(th.prompt)+'</pre>':'<p class=muted>idle</p>');
  const lat=node.latent||{};
  return '<h2>'+title+'</h2><p class=muted>'+(node.gpu||'')+' · role '+(node.role||'')+'</p><p>'+(node.smi||'')+'</p>'
    +(node.lock?'<p>lock '+node.lock+' comfy '+(node.comfy||'')+'</p>':'')
    +'<p>loaded '+aliases(node.loaded)+'</p>'
    +think+body
    +'<p class=muted>latent: '+(lat.kind||'')+' — '+(lat.note||'')+'</p>';
}
function render(d){
  const f=d.feed||{};
  const a0=d.app||{};
  document.getElementById('hdr').textContent=(d.localai||'')+' · worker '+(a0.worker_live?'LIVE':'down')+' · steer '+(d.steer&&d.steer.pause?'PAUSE':'run');
  document.getElementById('c0').innerHTML=card('akula-prime', f.prime||{});
  document.getElementById('c1').innerHTML=card('gpu5080', f.gpu5080||{});
  const t=f.gpu5080_1080ti||{};
  document.getElementById('c2').innerHTML=card('gpu5080-1080ti', t)
    +'<p class=muted>guest_ip '+(t.guest_ip||'none')+' live='+String(!!t.live)
    +' group='+esc(t.group||'')+' path='+esc(t.path||'')+' rag='+esc(t.rag||'')+'</p>';
  const p=f.pool||{};
  const cards=p.cards||[];
  const cardHtml=cards.map(c=>'<div class=card><h2>'+esc(c.id)+'</h2>'
    +'<p>'+esc(c.gpu||'')+'</p>'
    +'<p>'+(c.vram_mib||'?')+' MiB (~'+(c.gib!=null?c.gib:'?')+' GiB)</p>'
    +'<p class=muted>safeguard '+(c.safeguard_mib||'?')+' MiB (~'
    +(c.usable_gib!=null?c.usable_gib:'?')+' GiB)</p></div>').join('');
  const klass=p.live_1080ti?'~50 GiB class with 1080 Ti':'3090+5080 without 1080 Ti';
  document.getElementById('cpool').innerHTML='<h2>Unified pool</h2>'
    +'<p>'+(p.enabled?'RPC enabled':'Stage A placement — Stage B RPC off')+'</p>'
    +'<p>combined '+(p.combined_mib||'?')+' MiB (~'+(p.combined_gib!=null?p.combined_gib:'?')
    +' GiB) · usable '+(p.usable_mib||'?')+' MiB (~'
    +(p.usable_gib!=null?p.usable_gib:'?')+' GiB) · '+klass+'</p>'
    +'<div class=cols3>'+(cardHtml||'<p class=muted>no live cards</p>')+'</div>'
    +'<div class=bar><i style="width:100%"></i></div>'
    +'<p>mode '+(p.mode||'')+' · '+(p.mix||'')+'</p>'
    +'<p>parked '+JSON.stringify(p.parked||{})+'</p>'
    +'<p class=muted>'+(p.note||'')+'</p>';
  document.getElementById('raw').textContent=JSON.stringify({steer:d.steer,cluster:d.cluster,note:d.note,links:d.links},null,2);
  renderAuto(d.app||{});
}
function renderAuto(a){
  const now=a.now||{};
  const bits=splitThink(now.text||'');
  const inflight=now.inflight||now.prompt||'';
  let html='';
  if(bits.think) html+='<h3>thinking</h3><pre>'+esc(bits.think)+'</pre>';
  if(now.phase==='in-flight' && inflight) html+='<h3>in-flight</h3><pre>'+esc(inflight)+'</pre>';
  else if(bits.out) html+='<h3>'+esc(now.phase||'last')+'</h3><pre>'+esc(bits.out)+'</pre>';
  else if(inflight) html+='<h3>in-flight</h3><pre>'+esc(inflight)+'</pre>';
  else html+='<p class=muted>idle</p>';
  const anow=document.getElementById('anow');
  if(anow) anow.innerHTML=html;
  const ameta=document.getElementById('ameta');
  if(ameta) ameta.textContent='goal '+(now.goal||'')+' · files '+((now.files||[]).join(' ')||'none')+' · pytest rc '+(now.pytest_rc==null?'n/a':now.pytest_rc)+' · last.ok '+String(now.ok)+' · last.error '+(now.error||'');
  const q=document.getElementById('q');
  if(q) q.textContent=JSON.stringify({live:a.queue_live||[], recent_done:a.queue_recent_done||[]},null,2);
  const ticks=document.getElementById('ticks');
  if(ticks) ticks.textContent=JSON.stringify(a.ticks||[],null,2);
  const ahb=document.getElementById('ahb');
  const last=(a.heartbeat||{}).last||{};
  if(ahb) ahb.textContent=JSON.stringify({goal:last.goal,ok:last.ok,error:last.error},null,2);
}
async function spawnNow(){
  const alias=document.getElementById('sa').value||'local/code';
  const r=await fetch(BASE+'/api/spawn',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({alias,why:'lab-spawn'})});
  document.getElementById('so').textContent=JSON.stringify(await r.json(),null,2);
  refresh();
}
function renderGoals(g){
  const hb=g.heartbeat||{};
  document.getElementById('gnext').textContent=(g.next_goal||'')+' · pause '+String(!!((g.steer||{}).pause));
  document.getElementById('ghb').textContent=JSON.stringify({t:hb.t,pid:hb.pid,wt:hb.wt,age_s:hb.age_s,live:hb.live,last:hb.last},null,2);
  document.getElementById('gnotes').textContent=String(g.reasoning||g.notes||'');
  document.getElementById('gtodos').textContent=JSON.stringify(g.todos||[],null,2);
  const ping=g.grok_need||{};
  document.getElementById('gping').textContent=JSON.stringify({need:ping.need,question:ping.question,goal:ping.goal,mtime:ping.mtime},null,2);
  document.getElementById('gladder').textContent=JSON.stringify({hf:g.hf,scale_ladder:g.scale_ladder},null,2);
  const rows=g.phase1||[];
  const head='<table class=board><thead><tr><th>id</th><th>status</th><th>title</th><th>depends</th></tr></thead><tbody>';
  const body=rows.map(r=>'<tr class="st-'+esc(r.status)+'"><td>'+esc(r.id)+'</td><td>'+esc(r.status)+'</td><td>'+esc(r.title)+'</td><td>'+esc(r.depends)+'</td></tr>').join('');
  document.getElementById('gboard').innerHTML=head+body+'</tbody></table>';
}
async function loadGoals(){
  const r=await fetch(BASE+'/api/goals');
  renderGoals(await r.json());
}
async function refresh(){
  const r=await fetch(BASE+'/api/status'); const d=await r.json();
  render(d);
  if(document.getElementById('todos') && document.getElementById('todos').classList.contains('on')) loadGoals();
}
async function steer(body){
  await fetch(BASE+'/api/steer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  refresh();
}
async function loadHist(){
  const r=await fetch(BASE+'/api/sessions'); const d=await r.json();
  const rows=d.sessions||[];
  document.getElementById('hlist').innerHTML=rows.map(s=>
    '<p><button onclick="openSess(\\''+esc(s.id)+'\\')">'+esc(s.kind)+' '+esc(s.id)+'</button> '
    +esc((s.title||'').slice(0,60))+' <span class=muted>n='+s.n+'</span></p>'
  ).join('') || '<p class=muted>none yet</p>';
}
async function openSess(id){
  const r=await fetch(BASE+'/api/sessions?id='+encodeURIComponent(id));
  const d=await r.json();
  document.getElementById('hview').textContent=JSON.stringify(d,null,2);
}
async function go(){
  const prompt=document.getElementById('p').value;
  const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt})});
  const d=await r.json();
  document.getElementById('c').textContent=d.content||JSON.stringify(d);
}
if(location.hash==='#todos'||location.hash==='#goals'||location.pathname.indexOf('goals')>=0||location.pathname.indexOf('todos')>=0) tab('todos'); refresh(); if(document.getElementById('todos')&&document.getElementById('todos').classList.contains('on')) loadGoals(); setInterval(refresh,2000);
</script>
