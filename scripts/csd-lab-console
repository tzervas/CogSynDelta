#!/usr/bin/env python3
"""Monitor and steer lab GPUs + LocalAI from this machine.

Usage:
  ./scripts/csd-lab-console              # one snapshot
  ./scripts/csd-lab-console --watch
  ./scripts/csd-lab-console --http 9118  # dashboard (code.vectorweight.com/lab)
  ./scripts/csd-lab-console --chat 'ping'
  ./scripts/csd-lab-console --steer pause
  ./scripts/csd-lab-console --steer resume
  ./scripts/csd-lab-console --steer-note 'hold G-SQL'

Never pauses LocalAI. Never dual 14B. UI tabs: live dual-host feed (loaded
models only), pool, history, steer. No catalog dump on the feed tab.

JSON routes wrap existing CLIs (also under /lab prefix). Never 0.0.0.0.
Never widen apply allowlist. Never wrap csd-autodev-provision.
"""

from __future__ import annotations

