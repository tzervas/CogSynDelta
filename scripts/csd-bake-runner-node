#!/usr/bin/env bash
# Install Node LTS into /usr/local so Forgejo host-runners have `node` on PATH.
# actions/checkout@v7 requires Node 24+. Do not use NodeSource apt (SHA1 mirrors).
set -euo pipefail
VER="${NODE_LTS_VERSION:-24.20.0}"
ARCH="${NODE_ARCH:-x64}"
PREFIX="${NODE_PREFIX:-/usr/local}"
WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT
tarball="node-v${VER}-linux-${ARCH}.tar.xz"
base="https://nodejs.org/dist/v${VER}"
curl -fsSL "$base/SHASUMS256.txt" -o "$WORKDIR/SHASUMS256.txt"
curl -fsSL "$base/$tarball" -o "$WORKDIR/$tarball"
(
  cd "$WORKDIR"
  grep " $tarball\$" SHASUMS256.txt | sha256sum -c -
)
sudo tar -xJf "$WORKDIR/$tarball" -C "$PREFIX" --strip-components=1
hash -r
"$PREFIX/bin/node" -v
"$PREFIX/bin/npm" -v
echo "baked node $VER at $PREFIX/bin/node" >&2
