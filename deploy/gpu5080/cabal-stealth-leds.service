[Unit]
Description=Cabal stealth RGB (oneshot, no OpenRGB server)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=QT_QPA_PLATFORM=offscreen
Environment=CABAL_OPENRGB=/usr/local/lib/cabal/OpenRGB.AppImage
ExecStart=/usr/local/sbin/cabal-stealth-leds

[Install]
WantedBy=multi-user.target
