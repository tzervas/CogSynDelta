<script>
const BASE=location.pathname.indexOf('/lab')===0?'/lab':'';
function tab(id){
  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on', p.id===id));
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on', b.dataset.tab===id));
}
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{tab(b.dataset.tab); if(b.dataset.tab==='hist') loadHist();});
function esc(s){return String(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
function splitThink(t){
  t=t||'';
  const m=/<think>([\\s\\S]*?)<\\/think>/i.exec(t);
  return {think:m?m[1].trim():'', out:t.replace(/<think>[\\s\\S]*?<\\/think>/gi,'').trim()};
}
function aliases(list){
  if(!list||!list.length) return '<span class=muted>none loaded</span>';
  return list.map(x=>'<span class=alias>'+esc(x.alias)+(x.physical===false?' (logical)':'')+'</span>').join(' ');
}
function card(title, node){
  const th=node.thinking||{};
  const bits=splitThink(th.text||th.prompt||'');
  const think = bits.think ? '<h3>thinking</h3><pre>'+esc(bits.think)+'</pre>' : '';
  const body = bits.out ? '<h3>'+esc(th.phase||'activity')+'</h3><pre>'+esc(bits.out)+'</pre>' : (th.prompt?'<h3>in-flight</h3><pre>'+esc(th.prompt)+'</pre>':'<p class=muted>idle</p>');
  const lat=node.latent||{};
  return '<h2>'+title+'</h2><p class=muted>'+(node.gpu||'')+'</p><p>'+(node.smi||'')+'</p>'
    +(node.lock?'<p>lock '+node.lock+' comfy '+(node.comfy||'')+'</p>':'')
    +'<p>loaded '+aliases(node.loaded)+'</p>'
    +think+body
    +'<p class=muted>latent: '+(lat.kind||'')+' — '+(lat.note||'')+'</p>';
}
function render(d){
  const f=d.feed||{};
  const a0=d.app||{};
  document.getElementById('hdr').textContent=(d.localai||'')+' · worker '+(a0.worker_live?'LIVE':'down')+' · steer '+(d.steer&&d.steer.pause?'PAUSE':'run');
  document.getElementById('c0').innerHTML=card('akula-prime', f.prime||{});
  document.getElementById('c1').innerHTML=card('gpu5080', f.gpu5080||{});
  const p=f.pool||{};
  const used=p.combined_mib||39331;
  document.getElementById('cpool').innerHTML='<h2>Unified pool</h2>'
    +'<p>'+(p.enabled?'RPC enabled':'Stage A placement — Stage B RPC off')+'</p>'
    +'<p>combined '+(p.combined_mib||'?')+' MiB · usable '+(p.usable_mib||'?')+' MiB (~40 GiB class)</p>'
    +'<div class=bar><i style="width:100%"></i></div>'
    +'<p>mode '+(p.mode||'')+' · '+(p.mix||'')+'</p>'
    +'<p>parked '+JSON.stringify(p.parked||{})+'</p>'
    +'<p class=muted>'+(p.note||'')+'</p>'
    +'<p class=muted>Single pooled GGUF or a mix lands here when llama.cpp RPC and 5080 GGUFs exist. Tight decode stays on one card; ok-lan may split 24:16.</p>';
  document.getElementById('raw').textContent=JSON.stringify({steer:d.steer,note:d.note,links:d.links},null,2);
  const a=d.app||{};
  document.getElementById('q').textContent=JSON.stringify({live:a.queue_live||[], recent_done:a.queue_recent_done||[]},null,2);
  document.getElementById('ticks').textContent=JSON.stringify(a.ticks||[],null,2);
  document.getElementById('goals').textContent=(a.goals||[]).join('\\n');
  void used;
}
async function spawnNow(){
  const alias=document.getElementById('sa').value||'local/code';
  const r=await fetch(BASE+'/api/spawn',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({alias,why:'lab-spawn'})});
  document.getElementById('so').textContent=JSON.stringify(await r.json(),null,2);
  refresh();
}
async function refresh(){
  const r=await fetch(BASE+'/api/status'); const d=await r.json();
  render(d);
}
async function steer(body){
  await fetch(BASE+'/api/steer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  refresh();
}
async function loadHist(){
  const r=await fetch(BASE+'/api/sessions'); const d=await r.json();
  const rows=d.sessions||[];
  document.getElementById('hlist').innerHTML=rows.map(s=>
    '<p><button onclick="openSess(\\''+esc(s.id)+'\\')">'+esc(s.kind)+' '+esc(s.id)+'</button> '
    +esc((s.title||'').slice(0,60))+' <span class=muted>n='+s.n+'</span></p>'
  ).join('') || '<p class=muted>none yet</p>';
}
async function openSess(id){
  const r=await fetch(BASE+'/api/sessions?id='+encodeURIComponent(id));
  const d=await r.json();
  document.getElementById('hview').textContent=JSON.stringify(d,null,2);
}
async function go(){
  const prompt=document.getElementById('p').value;
  const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt})});
  const d=await r.json();
  document.getElementById('c').textContent=d.content||JSON.stringify(d);
}
refresh(); setInterval(refresh,2000);
</script>
"""


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--watch", action="store_true")
    ap.add_argument("--http", type=int, metavar="PORT")
    ap.add_argument("--chat")
    ap.add_argument("--steer", choices=["pause", "resume"])
    ap.add_argument("--steer-note")
    args = ap.parse_args()
    if args.steer:
        print(json.dumps(write_steer(pause=args.steer == "pause"), indent=2))
        return 0
    if args.steer_note is not None:
        print(json.dumps(write_steer(note=args.steer_note), indent=2))
        return 0
    if args.chat:
        print(chat(args.chat))
        return 0
    if args.http:
        serve(args.http)
        return 0
    if args.watch:
        while True:
            print("\033[2J\033[H", end="")
            print_snap(snapshot())
            time.sleep(5)
    print_snap(snapshot())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
