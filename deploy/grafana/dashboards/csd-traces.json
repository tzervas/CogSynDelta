          "expr": "sum by (group, service, host) (count_over_time({env=~\"$env\", host=~\"$host\", ns=~\"$ns\", group=~\"$group\", service=~\"$service\"} |~ \"(?i)trace[_-]?id|traceparent\" [5m]))",
