#!/usr/bin/env python3
"""Plan 3090/5080 splits for autodev. Never dual 14B. Never OOM on purpose."""
from __future__ import annotations

import json
import os
import subprocess
from pathlib import Path

OUT = Path(os.environ.get("CSD_GPU_PLAN", "/akula-data/cabal/gpu-plan.json"))


def smi_local() -> dict:
    p = subprocess.run(
        [
            "nvidia-smi",
            "--query-gpu=name,memory.used,memory.free,memory.total",
            "--format=csv,noheader,nounits",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    parts = [x.strip() for x in (p.stdout or "").split(",")]
    if len(parts) < 4:
        return {"error": p.stderr[:200]}
    used, free, total = (int(float(parts[i])) for i in (1, 2, 3))
    return {
        "name": parts[0],
        "used_mib": used,
        "free_mib": free,
        "total_mib": total,
        "role": "local/code",
        "second_14b": False,
        "share_small": free >= 4096,
        "share_small_job": "embed-0.6B" if free >= 4096 else None,
    }


def smi_5080() -> dict:
    p = subprocess.run(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=8",
            "gpu5080",
            "nvidia-smi --query-gpu=name,memory.used,memory.free,memory.total "
            "--format=csv,noheader,nounits; "
            "systemctl is-enabled akula-comfyui.service 2>/dev/null; "
            "fuser /home/tzervas/akula-harness/state/gpu5080.lock 2>/dev/null || echo lock=idle",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    lines = (p.stdout or "").strip().splitlines()
    parts = [x.strip() for x in (lines[0].split(",") if lines else [])]
    if len(parts) < 4:
        return {"error": (p.stderr or p.stdout)[:200]}
    used, free, total = (int(float(parts[i])) for i in (1, 2, 3))
    comfy = lines[1] if len(lines) > 1 else "?"
    lock = lines[-1] if len(lines) > 2 else "?"
    helper = free >= 6144 and "masked" in comfy and "idle" in lock
    return {
        "name": parts[0],
        "used_mib": used,
        "free_mib": free,
        "total_mib": total,
        "comfy": comfy,
        "lock": lock,
        "role": "cuda-tests" if not helper else "cuda-or-helper",
        "helper_ok": helper,
        "helper": "Qwen3-Embedding-0.6B in Comfy python3.13" if helper else None,
        "never": ["second 14B", "unmask Comfy during autodev"],
    }


def main() -> int:
    plan = {
        "autodev_priority": True,
        "akula-prime": smi_local(),
        "gpu5080": smi_5080(),
        "webui_host": "homelab",
        "text_implementer": "local/code via csd-localai-queue",
        "hosted_grok": "plan/unblock/safety only",
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(plan, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
