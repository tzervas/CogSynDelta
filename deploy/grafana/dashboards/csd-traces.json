      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "panels": [],
      "title": "Loki trace_id \u2192 Jaeger",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Jaeger trace_id",
              "url": "",
              "internal": {
                "datasourceName": "Jaeger",
                "datasourceUid": "csd-jaeger",
                "query": {
                  "query": "${__value.raw}",
                  "queryType": "traceId"
                }
              }
            },
            {
              "title": "Loki {group,service,host}",
              "url": "",
              "internal": {
                "datasourceName": "Loki",
                "datasourceUid": "P8E80F9AEF21F6940",
                "query": {
                  "expr": "{group=\"${__field.labels.group}\",service=\"${__field.labels.service}\",host=\"${__field.labels.host}\"}",
                  "queryType": "range",
                  "refId": "A"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "editorMode": "code",
          "expr": "{env=~\"$env\", host=~\"$host\", ns=~\"$ns\", group=~\"$group\", service=~\"$service\"} |~ \"(?i)trace[_-]?id|traceparent|traceId\" | regexp \"(?P<trace_id>[a-fA-F0-9]{16,32})\"",
          "maxLines": 200,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "lines with trace_id / traceparent",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
