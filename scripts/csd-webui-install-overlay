#!/usr/bin/env python3
"""Upsert CSD autodev overlay Tools into an Open WebUI sqlite DB.

Matches akula-ai-platform scripts/webui-install-overlay format. Does not
print valve tokens. Homelab: --db /data/akula/webui/data/webui.db while
the container is stopped if you copy the db; live sqlite may be enough
for Tools (no env change → no OWUI restart).
"""

from __future__ import annotations

import argparse
import json
import sqlite3
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
FN_DIR = ROOT / "config/webui/overlay/functions"
ADMIN_EMAIL_DEFAULT = "spooky_actual@proton.me"

