            "gpu": stub.get("gpu") or "GTX 1080 Ti",
            "arch": stub.get("arch"),
            "sm": stub.get("sm"),
            "vram_mib": stub.get("vram_mib"),
            "host_ip": GPU5080_IP,
            "guest_ip": guest_ip,
