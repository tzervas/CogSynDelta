#!/usr/bin/env python3
"""Observability for model training pipelines. Architecture-agnostic by construction.

WHAT THIS IS FOR
One console over every model pipeline on the fleet -- CSD's regions today, a ternary
architecture or anything else tomorrow. It knows nothing about any of them. It reads
receipts in the common envelope (cogsyndelta.pipeline.receipt) and renders whatever
metrics a producer chose to report, grouped by project, component and stage.

That is why it is not called csd-anything. The moment a console needs a branch for "if
this is CSD", it stops being a platform and becomes a second implementation.

WHAT IT DELIBERATELY DOES NOT DO YET
Start, stop or reconfigure a run. Read-only is a real boundary, not an unfinished one:
control needs authentication and an allowlist, and shipping a dashboard that can launch
training before that exists would be the wrong order. The JSON API is shaped so control
routes slot in beside it later.

BINDING
Defaults to loopback. A dashboard exposing checkpoint paths and fleet topology is not
something to put on 0.0.0.0 by accident, so a routable bind must be asked for explicitly.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import shutil
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from cogsyndelta.pipeline.receipt import Receipt, load_all

RECEIPT_ROOTS: list[Path] = []


def fleet_state() -> dict:
    """GPU and storage state, best-effort. A missing probe is reported, not fatal."""
    out: dict[str, object] = {"gpus": [], "storage": []}
    try:
        # S607: nvidia-smi is resolved from PATH deliberately. Its location differs
        # across the fleet's drivers and distros, and this reads GPU telemetry rather
        # than crossing a trust boundary.
        r = subprocess.run(
            [  # noqa: S607
                "nvidia-smi",
                "--query-gpu=name,utilization.gpu,memory.used,memory.total",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        for line in r.stdout.strip().splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) == 4:
                out["gpus"].append(
                    {
                        "name": parts[0],
                        "util": int(parts[1]),
                        "mem_used": int(parts[2]),
                        "mem_total": int(parts[3]),
                    }
                )
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    for path in ("/akula-data", "/bulk", "/mnt/bulk", "/mnt/fleet-datasets"):
        p = Path(path)
        if not p.is_dir():
            continue
        try:
            u = shutil.disk_usage(p)
        except OSError:
            continue
        out["storage"].append(
            {
                "path": path,
                "used_pct": round(100 * u.used / u.total, 1),
                "free_gb": round(u.free / 1e9),
                "total_gb": round(u.total / 1e9),
            }
        )
    return out


def summarise(receipts: list[Receipt]) -> list[dict]:
    """Latest run per (project, component, stage), with its trend across earlier runs."""
    groups: dict[tuple[str, str, str], list[Receipt]] = {}
    for r in receipts:
        groups.setdefault((r.producer.project, r.producer.component, r.stage), []).append(r)
    rows = []
    for (project, component, stage), items in sorted(groups.items()):
        latest = items[0]
        primary = next(iter(latest.metrics), None)
        rows.append(
            {
                "project": project,
                "component": component,
                "stage": stage,
                "architecture": latest.producer.architecture,
                "passed": latest.passed,
                "when": latest.started_utc,
                "runs": len(items),
                "metrics": latest.metrics,
                "baseline": latest.baseline,
                "gates": latest.gates,
                "primary_metric": primary,
                # Every run's primary metric, oldest first, so a reader can see direction
                # without knowing what the metric means.
                "trend": [i.metrics.get(primary) for i in reversed(items) if primary in i.metrics],
            }
        )
    return rows


def _escape(value: str) -> str:
    """Escape a Prometheus label value.

    Backslash, double quote and newline are the three characters that break the exposition
    format. A component name is free text from a producer, so it gets escaped rather than
    trusted -- an unescaped quote makes the whole scrape unparseable, not just one line.
    """
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def _labels(pairs: dict[str, str]) -> str:
    return ",".join(f'{k}="{_escape(str(v))}"' for k, v in pairs.items() if v != "")


def prometheus_text(receipts: list[Receipt]) -> str:
    """Render receipts in the Prometheus exposition format.

    Metric NAMES stay constant and the varying part goes in labels. A metric called
    `recall@1` is not a legal Prometheus name, and minting one series per metric name
    would also mean the schema changes every time a new architecture reports something
    novel -- which is precisely what the envelope exists to avoid. So there is one gauge,
    `model_pipeline_metric`, carrying the metric name as a label.

    Only the newest run per (project, component, stage) is exported. VictoriaMetrics keeps
    the history itself; re-exporting every past run would rewrite that history on every
    scrape with whatever timestamp the scrape happened to have.
    """
    latest: dict[tuple[str, str, str], Receipt] = {}
    for r in receipts:  # load_all returns newest first
        latest.setdefault((r.producer.project, r.producer.component, r.stage), r)

    lines = [
        "# HELP model_pipeline_metric A metric reported by a pipeline stage",
        "# TYPE model_pipeline_metric gauge",
    ]
    baselines = [
        "# HELP model_pipeline_baseline The baseline a metric should be read against",
        "# TYPE model_pipeline_baseline gauge",
    ]
    gates = [
        "# HELP model_pipeline_gate 1 if this gate held, 0 if it did not",
        "# TYPE model_pipeline_gate gauge",
    ]
    passed = [
        "# HELP model_pipeline_passed 1 if every gate on the run held",
        "# TYPE model_pipeline_passed gauge",
    ]
    seconds = [
        "# HELP model_pipeline_duration_seconds Wall time of the stage",
        "# TYPE model_pipeline_duration_seconds gauge",
    ]

    for (project, component, stage), r in sorted(latest.items()):
        base = {
            "project": project,
            "component": component,
            "stage": stage,
            "architecture": r.producer.architecture,
        }
        for name, value in r.metrics.items():
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                lines.append(
                    f"model_pipeline_metric{{{_labels({**base, 'metric': name})}}} {value}"
                )
        for name, value in r.baseline.items():
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                baselines.append(
                    f"model_pipeline_baseline{{{_labels({**base, 'metric': name})}}} {value}"
                )
        for name, ok in r.gates.items():
            gates.append(
                f"model_pipeline_gate{{{_labels({**base, 'gate': name})}}} {int(bool(ok))}"
            )
        passed.append(f"model_pipeline_passed{{{_labels(base)}}} {int(r.passed)}")
        if r.seconds:
            seconds.append(f"model_pipeline_duration_seconds{{{_labels(base)}}} {r.seconds}")

    return "\n".join(lines + baselines + gates + passed + seconds) + "\n"


PAGE = """<!doctype html><html><head><meta charset="utf-8">
<title>Model Pipeline Console</title>
<style>
:root{--bg:#0f1115;--card:#171a21;--line:#262b36;--fg:#e6e9ef;--dim:#8b94a7;--ok:#3fb950;--bad:#f85149;--accent:#58a6ff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{padding:18px 24px;border-bottom:1px solid var(--line);display:flex;align-items:baseline;gap:16px;flex-wrap:wrap}
h1{font-size:17px;margin:0;font-weight:600}
.sub{color:var(--dim);font-size:12px}
main{padding:20px 24px;max-width:1400px}
