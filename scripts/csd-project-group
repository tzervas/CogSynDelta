#!/usr/bin/env python3
"""Group CogSynDelta lab artifacts on Forgejo (topics) and HF (plan).

Forgejo Projects API is 404 here until admin enables Projects. Topics
are the grouping that works today. HF collection apply needs HF_TOKEN.

  csd-project-group list
  csd-project-group apply-topics   # Forgejo repo topics
  csd-project-group plan-forks     # print candidates; no clone
"""
from __future__ import annotations

import argparse
import json
import os
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CAT = json.loads((ROOT / "config/project-group.json").read_text(encoding="utf-8"))
FJ = "https://git.vectorweight.com/api/v1"


def token() -> str:
    return os.environ.get("TOKEN") or os.environ.get("FORGEJO_TOKEN") or ""


def api(method: str, path: str, body: dict | None = None) -> tuple[int, object]:
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        FJ + path,
        data=data,
        method=method,
        headers={
            "Authorization": f"token {token()}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode()
            return resp.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode()[:400]


def list_group() -> dict:
    owner = CAT["forgejo"]["owner"]
    repos = []
    for rec in CAT["forgejo"]["repos"]:
        code, data = api("GET", f"/repos/{owner}/{rec['name']}")
        topics = []
        if code == 200 and isinstance(data, dict):
            tcode, tdata = api("GET", f"/repos/{owner}/{rec['name']}/topics")
            if tcode == 200 and isinstance(tdata, dict):
                topics = tdata.get("topics") or []
        repos.append({"name": rec["name"], "http": code, "topics": topics})
    return {
        "forgejo_projects_api": "404 — use topics until Projects is enabled",
        "repos": repos,
        "fork_candidates": CAT["forgejo"]["fork_candidates"],
        "hf": CAT["huggingface"],
        "webui": "https://ai.vectorweight.com",
        "lab": "https://code.vectorweight.com",
    }


def apply_topics() -> dict:
    owner = CAT["forgejo"]["owner"]
    want = list(CAT["forgejo"]["topics"])
    out = []
    for rec in CAT["forgejo"]["repos"]:
        code, data = api("PUT", f"/repos/{owner}/{rec['name']}/topics", {"topics": want})
        out.append({"name": rec["name"], "http": code, "body": data})
    return {"ok": all(x["http"] in {200, 204} for x in out), "repos": out}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["list", "apply-topics", "plan-forks"])
    args = ap.parse_args()
    if args.cmd == "list":
        print(json.dumps(list_group(), indent=2, default=str))
        return 0
    if args.cmd == "plan-forks":
        print(json.dumps(CAT["forgejo"]["fork_candidates"], indent=2))
        print(json.dumps(CAT["huggingface"]["fork_candidates"], indent=2))
        return 0
    rec = apply_topics()
    print(json.dumps(rec, indent=2, default=str))
    return 0 if rec.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
