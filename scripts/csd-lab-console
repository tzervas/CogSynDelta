WAN_BINDS = frozenset({"0.0.0.0", "::", "[::]"})


def sh(args: list[str], timeout: int = 20) -> str:
    p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    return (p.stdout or p.stderr or "").strip()


def ssh_5080(cmd: str) -> str:
    return sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", GPU5080, cmd])


def localai_key() -> str:
    return os.environ.get("LOCALAI_API_KEY") or os.environ.get("API_KEY") or ""


def _read_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


def _latest_queue() -> dict:
    """Running job, else newest result. Why: feed shows thinking, not catalog."""
    if not QUEUE_DIR.is_dir():
        return {}
    running: dict = {}
    newest: tuple[float, dict] | None = None
    for path in QUEUE_DIR.glob("*.json"):
        rec = _read_json(path)
        if not rec:
            continue
        mtime = path.stat().st_mtime
        if rec.get("status") == "running":
            running = rec
        if newest is None or mtime > newest[0]:
            newest = (mtime, rec)
    if running:
        return running
    return newest[1] if newest else {}


def _latest_autodev() -> dict:
    if not AUTODEV_OUT.is_dir():
        return {}
    files = list(AUTODEV_OUT.glob("*.json"))
    if not files:
        return {}
    return _read_json(max(files, key=lambda p: p.stat().st_mtime))


def loaded_only() -> dict:
    """Currently placed aliases from the router, expired dropped."""
    st = _read_json(ROUTER_STATE)
    now = time.time()
    prime: list[dict] = []
    gpu: list[dict] = []
    for alias, rec in (st.get("resident") or {}).items():
        if not isinstance(rec, dict):
            continue
        if float(rec.get("until") or 0) <= now:
            continue
        item = {"alias": alias, **rec}
        if rec.get("host") == "gpu5080":
            gpu.append(item)
        else:
            prime.append(item)
    return {"prime": prime, "gpu5080": gpu, "parked": st.get("parked") or {}}


def live_feed(snap: dict) -> dict:
    """Dual-host live pane: loaded models, activity, honest latent note."""
    loaded = loaded_only()
    qjob = _latest_queue()
    aout = _latest_autodev()
    thinking = None
    if qjob.get("status") == "running":
        thinking = {
            "phase": "in-flight",
            "alias": qjob.get("alias"),
            "prompt": str(qjob.get("prompt") or "")[:2000],
        }
    elif qjob.get("result") or aout.get("text"):
        thinking = {
            "phase": "last",
            "alias": qjob.get("alias") or "local/code",
            "text": str(qjob.get("result") or aout.get("text") or "")[:4000],
            "goal": aout.get("goal"),
        }
    plan = _read_json(GPU_PLAN)
    pool = plan.get("pool") or {
        "combined_mib": 39331,
        "usable_mib": 37795,
        "enabled": False,
    }
    return {
        "prime": {
            "gpu": "RTX 3090 Ti Ampere sm_86",
            "smi": snap.get("prime_smi"),
            "loaded": loaded["prime"],
            "thinking": thinking,
            "latent": {
                "kind": "kv-occupancy",
                "note": (
                    "GGUF decode has no public latent hook. VRAM used is "
                    "weights+KV. CSD region latents are not in this console."
                ),
            },
        },
        "gpu5080": {
            "gpu": "RTX 5080 Blackwell sm_120",
            "smi": snap.get("gpu5080_smi"),
            "lock": snap.get("gpu5080_lock"),
            "comfy": snap.get("gpu5080_comfy"),
            "loaded": loaded["gpu5080"],
            "thinking": None,
            "latent": {
                "kind": "embed-or-cuda",
                "note": (
                    "No LLM thinking on CUDA jobs. Embed probe appears when "
                    "a helper is physically loaded (gguf_count>0)."
                ),
            },
        },
        "pool": {
            **pool,
            "parked": loaded["parked"],
            "mode": "place-then-pool",
            "mix": "single-or-mix when Stage B RPC is enabled",
            "note": "Unified pool tab. llama.cpp RPC is specified, not enabled.",
        },
    }


def snapshot() -> dict:
    steer = {}
    if STEER.is_file():
        try:
            steer = json.loads(STEER.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            steer = {"error": "invalid json"}
    models: list[str] = []
    lai = "down"
    try:
        req = urllib.request.Request(
            f"{LOCALAI}/v1/models",
            headers={"Authorization": f"Bearer {localai_key()}"} if localai_key() else {},
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.load(resp)
        models = [m.get("id") for m in (data.get("data") or []) if m.get("id")]
        lai = "ok"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        lai = "unreachable"
    out = {
        "prime_smi": sh(
            [
                "nvidia-smi",
                "--query-gpu=name,memory.used,memory.free,utilization.gpu",
                "--format=csv,noheader",
            ]
        ),
        "localai": lai,
        "models": models,
        "localai_container": sh(["docker", "inspect", "-f", "{{.State.Status}}", "akula-localai"]),
        "gpu5080_smi": ssh_5080(
            "nvidia-smi --query-gpu=name,memory.used,memory.free,utilization.gpu --format=csv,noheader"
        ),
        "gpu5080_lock": ssh_5080(
            "fuser /home/tzervas/akula-harness/state/gpu5080.lock 2>/dev/null || echo idle"
        ),
        "gpu5080_runner": ssh_5080("systemctl --user is-active forgejo-runner-gpu-tzervas.service"),
        "gpu5080_comfy": ssh_5080("systemctl is-enabled akula-comfyui.service 2>/dev/null || true"),
        "steer": steer,
        "note": "autodev webapp on code.vectorweight.com; chat on ai.vectorweight.com",
        "links": {
            "lab": "https://code.vectorweight.com",
            "chat": "https://ai.vectorweight.com",
            "forgejo": "https://git.vectorweight.com/tzervas/CogSynDelta",
            "grafana": "https://grafana.vectorweight.com",
            "logs": "https://loki.vectorweight.com",
            "metrics": "https://vm.vectorweight.com",
            "status": "https://status.vectorweight.com",
        },
    }
    out["feed"] = live_feed(out)
    out["app"] = autodev_app()
    return out


def autodev_app() -> dict:
    """Queue, goals, and latest ticks for the lab webapp."""
    queue: list[dict] = []
    live: list[dict] = []
    if QUEUE_DIR.is_dir():
        files = sorted(QUEUE_DIR.glob("*.json"), key=lambda p: -p.stat().st_mtime)
        for path in files:
            if path.name.endswith(".result.json"):
                continue
            rec = _read_json(path)
            item = {
                "id": rec.get("id") or path.stem,
                "status": rec.get("status"),
                "kind": rec.get("kind"),
                "alias": rec.get("alias"),
                "prio": rec.get("prio"),
            }
            if item["status"] in {"queued", "running"}:
                live.append(item)
            elif len(queue) < 12:
                queue.append(item)
    goals = []
    if GOALS.is_file():
        goals = [ln for ln in GOALS.read_text(encoding="utf-8").splitlines() if "| G-" in ln][:24]
    ticks = []
    if AUTODEV_OUT.is_dir():
        files = sorted(AUTODEV_OUT.glob("*.json"), key=lambda p: -p.stat().st_mtime)[:8]
        for path in files:
            rec = _read_json(path)
            ticks.append(
                {
                    "id": path.stem,
                    "goal": str(rec.get("goal") or "")[:120],
                    "ok": rec.get("rc") == 0,
                    "applied": rec.get("applied"),
                }
            )
    cat = _read_json(ROUTER_JSON)
    runtimes = {
        name: {
            "best_for": spec.get("best_for"),
            "image": spec.get("image"),
            "hosts": spec.get("hosts"),
        }
        for name, spec in (cat.get("runtimes") or {}).items()
    }
    hb = _read_json(Path("/akula-data/cabal/autodev-heartbeat.json"))
    age = time.time() - float(hb.get("t") or 0) if hb else None
    return {
        "queue_live": live,
        "queue_recent_done": queue,
        "queue": live or queue,
        "worker_live": bool(age is not None and age < 90),
        "worker_age_s": age,
        "goals": goals,
        "ticks": ticks,
        "runtimes": runtimes,
        "parallel": "3090 text + 5080 CUDA/helpers at once; interned GEMM later",
    }


def print_snap(s: dict) -> None:
    print("=== akula-prime 3090 ===")
    print(s.get("prime_smi"))
    print("localai", s.get("localai_container"), s.get("localai"))
    feed = s.get("feed") or {}
    print("loaded prime", [x.get("alias") for x in (feed.get("prime") or {}).get("loaded") or []])
    print("=== gpu5080 ===")
    print(s.get("gpu5080_smi"))
    print(
        "lock",
        s.get("gpu5080_lock"),
        "runner",
        s.get("gpu5080_runner"),
        "comfy",
        s.get("gpu5080_comfy"),
    )
    print("loaded 5080", [x.get("alias") for x in (feed.get("gpu5080") or {}).get("loaded") or []])
    print("=== steer ===")
    print(json.dumps(s.get("steer") or {}, indent=2))
    print(s.get("note"))


def write_steer(**fields: object) -> dict:
    cur: dict = {}
    if STEER.is_file():
        try:
            cur = json.loads(STEER.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            cur = {}
    cur.update({k: v for k, v in fields.items() if v is not None})
    STEER.parent.mkdir(parents=True, exist_ok=True)
    STEER.write_text(json.dumps(cur, indent=2) + "\n", encoding="utf-8")
    return cur


def list_sessions() -> list[dict]:
    """Historic lab chats (daily files) plus autodev ticks."""
    items: list[dict] = []
    if SESS_DIR.is_dir():
        for path in SESS_DIR.glob("chat-*.json"):
            rec = _read_json(path)
            turns = rec.get("turns") or []
            title = ""
            if turns:
                title = str(turns[0].get("prompt") or "")[:80]
            items.append(
                {
                    "id": path.stem,
                    "kind": "chat",
                    "t": path.stat().st_mtime,
                    "n": len(turns),
                    "title": title,
                }
            )
    if AUTODEV_OUT.is_dir():
        for path in AUTODEV_OUT.glob("*.json"):
            rec = _read_json(path)
            items.append(
                {
                    "id": f"autodev-{path.stem}",
                    "kind": "autodev",
                    "t": float(rec.get("t") or path.stat().st_mtime),
                    "n": 1,
                    "title": str(rec.get("goal") or path.stem)[:80],
                }
            )
    items.sort(key=lambda r: -float(r.get("t") or 0))
    return items[:200]


def load_session(sid: str) -> dict:
    """Load one historic session by id (chat-YYYY-MM-DD or autodev-TS)."""
    if sid.startswith("autodev-"):
        path = AUTODEV_OUT / f"{sid[len('autodev-') :]}.json"
        rec = _read_json(path)
        rec["id"] = sid
        rec["kind"] = "autodev"
        return rec
    if ".." in sid or "/" in sid:
        return {"error": "bad id"}
    rec = _read_json(SESS_DIR / f"{sid}.json")
    rec["id"] = sid
    rec["kind"] = "chat"
    return rec


def append_chat(prompt: str, reply: str, alias: str) -> None:
    """Append a lab chat turn to today's session file."""
    SESS_DIR.mkdir(parents=True, exist_ok=True)
    day = time.strftime("%Y-%m-%d")
    path = SESS_DIR / f"chat-{day}.json"
    rec = _read_json(path)
    if not rec:
        rec = {"id": f"chat-{day}", "kind": "chat", "turns": []}
    rec.setdefault("turns", []).append(
        {
            "t": time.time(),
            "alias": alias,
            "prompt": prompt,
            "reply": reply,
        }
    )
    path.write_text(json.dumps(rec, indent=2) + "\n", encoding="utf-8")


def apply_token() -> str:
    if os.environ.get("CSD_APPLY_TOKEN"):
        return os.environ["CSD_APPLY_TOKEN"].strip()
    if APPLY_TOKEN_FILE.is_file():
        return APPLY_TOKEN_FILE.read_text(encoding="utf-8").strip()
    return ""


def check_apply_auth(header: str) -> bool:
    """Bearer token compare. Why: worktree writes without SSH."""
    want = apply_token()
    if not want:
        return False
    got = header or ""
    if got.lower().startswith("bearer "):
        got = got[7:].strip()
    return hmac.compare_digest(got, want)


def http_apply(worktree: str, rel: str, content: str) -> dict:
    """Allowlisted worktree write. Never kang-main-wip."""
    dest = WORKTREES.get(worktree)
    if dest is None or not dest.is_dir():
        return {"ok": False, "error": f"unknown worktree {worktree}"}
    if dest.resolve() == PROTECTED_WT.resolve():
        return {"ok": False, "error": "refusing kang-main-wip"}
    rel = rel.lstrip("/")
    if ".." in Path(rel).parts or not rel.startswith(ALLOW_PREFIXES):
        return {"ok": False, "error": f"path not allowed: {rel}"}
    if len(content) > 400_000:
        return {"ok": False, "error": "content too large"}
    target = (dest / rel).resolve()
    if dest.resolve() not in target.parents:
        return {"ok": False, "error": "escaped worktree"}
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")
    return {"ok": True, "wrote": str(target)}


def _scrub(text: str) -> str:
    """Strip token-like assignments from CLI text. Never print secrets."""
    return re.sub(
        r"(?i)(token|bearer|authorization|api[_-]?key)\s*[:=]\s*\S+",
        r"\1=<redacted>",
        text,
    )


def _parse_last_json(text: str) -> dict:
    """Parse the last JSON object from CLI stdout."""
    blob = (text or "").strip()
    if not blob:
        return {}
    start = blob.rfind("{")
    if start >= 0:
        try:
            data = json.loads(blob[start:])
            if isinstance(data, dict):
                return data
        except json.JSONDecodeError:
            pass
    for line in reversed(blob.splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            data = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(data, dict):
            return data
    return {}


def _run_cli(argv: list[str], timeout: int = 90) -> tuple[int, str]:
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    out = _scrub((p.stdout or "").strip())
    err = _scrub((p.stderr or "").strip())
    text = out if out else err
    return p.returncode, text[:8000]


def _forgejo_argv(rest: list[str]) -> list[str]:
    """autodev Forgejo CLI; TOKEN from env or CSD vault. Never operator admin."""
    cli = str(FORGEJO_CLI)
    if os.environ.get("TOKEN") or os.environ.get("FORGEJO_TOKEN"):
        return [cli, *rest]
    return [SECRET_BIN, "exec", "TOKEN=git/autodev", "--", cli, *rest]


def _repo_ok(raw: str) -> str | None:
    name = raw if "/" in raw else f"tzervas/{raw}"
    if name not in FORGEJO_ALLOW:
        return None
    return name


def _as_int(val: object, default: int, lo: int, hi: int) -> int:
    try:
        n = int(val)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        n = default
    return max(lo, min(n, hi))


def lab_git(args: list[object]) -> dict:
    """JSON wrap of scripts/csd-autodev-git. Never GitHub. Never protected trunks."""
    if not args or not all(isinstance(a, str) for a in args):
        return {"ok": False, "rc": 2, "stdout": "args must be a string array"}
    argv = [str(a) for a in args]
    if any("github.com" in a.lower() for a in argv):
        return {"ok": False, "rc": 2, "stdout": "never GitHub"}
    if any(a == "-c" or a.startswith("--exec") or "credential" in a.lower() for a in argv):
        return {"ok": False, "rc": 2, "stdout": "refusing git config/credential args"}
    if argv[0] in {"push", "checkout", "switch", "merge", "rebase"}:
        for a in argv[1:]:
            for branch in PROTECTED_REFS:
                if a == branch or a.endswith(f":{branch}") or a.endswith(f"/{branch}"):
                    return {
                        "ok": False,
                        "rc": 2,
                        "stdout": f"refusing {argv[0]} {branch}",
                    }
    try:
        rc, text = _run_cli([str(GIT_CLI), *argv], timeout=120)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "rc": 1, "stdout": str(exc)[:400]}
    return {"ok": rc == 0, "rc": rc, "stdout": text}


def lab_gpu(refresh: bool = False) -> dict:
    """Wrap csd-gpu-plan. Prefer CSD_GPU_PLAN file to avoid extra SSH."""
    if not refresh:
        plan = _read_json(GPU_PLAN)
        if plan.get("akula-prime") is not None and plan.get("gpu5080") is not None:
            return plan
    try:
        rc, text = _run_cli([str(GPU_PLAN_CLI)], timeout=40)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)[:200]}
    data = _parse_last_json(text)
    if data.get("akula-prime") is not None:
        return data
    plan = _read_json(GPU_PLAN)
    if plan:
        return plan
    return {"ok": False, "error": text[:400], "rc": rc}


def lab_gpu_lock() -> dict:
    """Observe gpu5080.lock from the plan. Acquire/release is not here."""
    plan = lab_gpu(refresh=False)
    g = plan.get("gpu5080") if isinstance(plan.get("gpu5080"), dict) else {}
    return {
        "lock": str(g.get("lock") or "unknown"),
        "comfy": str(g.get("comfy") or "unknown"),
        "helper_ok": bool(g.get("helper_ok")),
    }


def lab_priority(action: str) -> dict:
    """Wrap csd-autodev-priority on|off|status. Never pause 3090 LocalAI."""
    if action not in {"on", "off", "status"}:
        return {"ok": False, "error": "action must be on|off|status"}
    try:
        _rc, text = _run_cli([str(PRIORITY_CLI), action], timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)[:200]}
    steer: dict = {}
    comfy = ""
    webui = ""
    for line in text.splitlines():
        if line.startswith("steer="):
            try:
                parsed = json.loads(line[6:])
            except json.JSONDecodeError:
                parsed = {}
            if isinstance(parsed, dict):
                steer = parsed
        elif line.startswith("comfy=") or line.startswith("comfy:"):
            comfy = line.split(":", 1)[-1].split("=", 1)[-1].strip()
        elif "webui" in line.lower():
            webui = line.strip()
    if not steer and STEER.is_file():
        steer = _read_json(STEER)
    return {"steer": steer, "comfy": comfy, "webui": webui}


def lab_loop(mode: str) -> dict:
    """Wrap csd-autodev-loop --once. Worker is systemd, not HTTP."""
    if mode == "worker":
        hb = _read_json(HEARTBEAT)
        last = hb.get("last") if isinstance(hb.get("last"), dict) else {}
        age = time.time() - float(hb.get("t") or 0) if hb.get("t") else None
        live = bool(age is not None and age < 90)
        return {
            "ok": live,
            "rc": 0 if live else 1,
            "goal": str(last.get("goal") or ""),
            "applied": last.get("applied") if isinstance(last.get("applied"), dict) else {},
            "out": "",
            "notes": ("worker is systemd csd-autodev-loop.service; HTTP does not spawn it"),
        }
    if mode != "once":
        return {
            "ok": False,
            "rc": 2,
            "goal": "",
            "applied": {},
            "out": "mode must be once|worker",
        }
    try:
        rc, text = _run_cli([str(LOOP_CLI), "--once"], timeout=300)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "rc": 1, "goal": "", "applied": {}, "out": str(exc)[:400]}
    rec = _parse_last_json(text)
    applied = rec.get("applied") if isinstance(rec.get("applied"), dict) else {}
    return {
        "ok": bool(rec.get("ok")) if rec else rc == 0,
        "rc": rc,
        "goal": str(rec.get("goal") or ""),
        "applied": applied,
        "out": str(rec.get("out") or text[:2000]),
    }


def lab_forgejo(cmd: str, payload: dict) -> dict:  # noqa: PLR0911
    """JSON wrap of csd-autodev-forgejo. Allowlisted repos only."""
    rest: list[str] = []
    timeout = 90
    if cmd == "whoami":
        rest = ["whoami"]
    elif cmd == "prs":
        repo = str(payload.get("repo") or "")
        if not _repo_ok(repo):
            return {
                "http": 400,
                "repo": repo,
                "pulls": [],
                "error": "repo not allowlisted",
            }
        limit = _as_int(payload.get("limit"), 20, 1, 100)
        rest = [
            "prs",
            repo,
            "--state",
            str(payload.get("state") or "open"),
            "--limit",
            str(limit),
        ]
    elif cmd == "pr-create":
        repo = str(payload.get("repo") or "")
        title = str(payload.get("title") or "")
        head = str(payload.get("head") or "")
        if not _repo_ok(repo) or not title or not head:
            return {"http": 400, "error": "repo, title, head required"}
        if head in PROTECTED_REFS:
            return {"http": 400, "error": f"refusing head {head}"}
        rest = [
            "pr-create",
            repo,
            title,
            head,
            "--base",
            str(payload.get("base") or "main"),
            "--body",
            str(payload.get("body") or ""),
        ]
    elif cmd == "status":
        repo = str(payload.get("repo") or "")
        sha = str(payload.get("sha") or "")
        if not _repo_ok(repo) or not sha:
            return {
                "http": 400,
                "state": "error",
                "checks": [],
                "error": "repo and sha required",
            }
        rest = ["status", repo, sha]
    elif cmd == "wait":
        repo = str(payload.get("repo") or "")
        sha = str(payload.get("sha") or "")
        if not _repo_ok(repo) or not sha:
            return {"http": 400, "state": "error", "error": "repo and sha required"}
        wait_t = _as_int(payload.get("timeout"), 1800, 1, 1800)
        poll = _as_int(payload.get("poll"), 30, 1, 120)
        rest = ["wait", repo, sha, "--timeout", str(wait_t), "--poll", str(poll)]
        timeout = wait_t + poll + 15
    elif cmd == "comment":
        repo = str(payload.get("repo") or "")
        body = str(payload.get("body") or "")
        number = payload.get("number")
        if not _repo_ok(repo) or not body or number is None:
            return {"http": 400, "ok": False, "error": "repo, number, body required"}
        rest = ["comment", repo, str(int(number)), body]
    elif cmd == "merge-gate":
        repo = str(payload.get("repo") or "")
        sha = str(payload.get("sha") or "")
        number = payload.get("number")
        if not _repo_ok(repo) or not sha or number is None:
            return {
                "ok": False,
                "state": "error",
                "merged": False,
                "required_ran": False,
                "required_succeeded": False,
                "notes": "repo, sha, number required",
            }
        rest = ["merge-gate", repo, sha, str(int(number))]
        timeout = 120
    else:
        return {"ok": False, "error": f"unknown forgejo cmd {cmd}"}
    try:
        rc, text = _run_cli(_forgejo_argv(rest), timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "http": 0, "error": str(exc)[:200]}
    rec = _parse_last_json(text)
    if not rec:
        rec = {"ok": rc == 0, "error": text[:400]}
    rec.setdefault("ok", rc == 0)
    return rec


def _qs_payload(query: str) -> dict:
    q = parse_qs(query)
    out: dict = {}
    for key, vals in q.items():
        if not vals:
            continue
        out[key] = vals[0]
    for key in ("limit", "number", "timeout", "poll"):
        if key in out:
            try:
                out[key] = int(out[key])
            except (TypeError, ValueError):
                out.pop(key, None)
    if "pause" in out:
        out["pause"] = str(out["pause"]).lower() in {"1", "true", "yes"}
    if "refresh" in out:
        out["refresh"] = str(out["refresh"]).lower() in {"1", "true", "yes"}
    if "autodev_priority" in out:
        out["autodev_priority"] = str(out["autodev_priority"]).lower() in {
            "1",
            "true",
            "yes",
        }
    return out


def handle_lab(method: str, path: str, payload: dict) -> tuple[int, dict] | None:  # noqa: PLR0911
    """Lab JSON routes wrapping existing CLIs. None = not a wrap route."""
    if len(path) > 1:
        path = path.rstrip("/")
    if path == "/api/gpu":
        return 200, lab_gpu(refresh=bool(payload.get("refresh")))
    if path == "/api/gpu/lock":
        return 200, lab_gpu_lock()
    if path == "/api/git":
        if method != "POST":
            return 405, {"ok": False, "rc": 405, "stdout": "POST args"}
        args = payload.get("args") if isinstance(payload.get("args"), list) else []
        return 200, lab_git(args)
    if path == "/api/loop":
        if method != "POST":
            return 405, {"ok": False, "rc": 405, "out": "POST mode"}
        return 200, lab_loop(str(payload.get("mode") or ""))
    if path == "/api/priority":
        return 200, lab_priority(str(payload.get("action") or "status"))
    if path == "/api/steer" and method == "GET":
        return 200, _read_json(STEER)
    if path == "/api/forgejo/whoami":
        return 200, lab_forgejo("whoami", payload)
    if path == "/api/forgejo/prs":
        return 200, lab_forgejo("prs", payload)
    if path == "/api/forgejo/pr-create":
        if method != "POST":
            return 405, {"http": 405, "error": "POST"}
        return 200, lab_forgejo("pr-create", payload)
    if path == "/api/forgejo/status":
        return 200, lab_forgejo("status", payload)
    if path == "/api/forgejo/wait":
        return 200, lab_forgejo("wait", payload)
    if path == "/api/forgejo/comment":
        if method != "POST":
            return 405, {"http": 405, "ok": False}
        return 200, lab_forgejo("comment", payload)
    if path == "/api/forgejo/merge-gate":
        if method != "POST":
            return 405, {
                "ok": False,
                "state": "error",
                "merged": False,
                "notes": "POST",
            }
        return 200, lab_forgejo("merge-gate", payload)
    return None


def lab_bind() -> str:
    """LAN bind only. Why: never expose the lab agent on WAN 0.0.0.0."""
    bind = os.environ.get("CSD_LAB_BIND", "192.168.1.98")
    if bind in WAN_BINDS:
        raise SystemExit("refusing WAN bind 0.0.0.0")
    return bind


def spawn_alias(alias: str, why: str) -> dict:
    """Stand a catalog alias on 3090 or 5080 without dual 14B."""
    router = Path(__file__).resolve().parents[1] / "scripts/csd-model-router"
    p = subprocess.run(
        [str(router), "request", "--alias", alias, "--why", why, "--noping"],
        capture_output=True,
        text=True,
        check=False,
        timeout=60,
    )
    try:
        rec = json.loads(p.stdout or "{}")
    except json.JSONDecodeError:
        rec = {"ok": False, "error": (p.stdout or p.stderr or "")[:400]}
    rec["rc"] = p.returncode
    return rec


def comfy_tool(cmd: str, payload: dict | None = None) -> dict:
    """Lab JSON wrap of scripts/csd-comfy. Fail-closed when masked."""
    script = Path(__file__).resolve().parent / "csd-comfy"
    p = subprocess.run(
        [str(script), cmd],
        input=json.dumps(payload or {}),
        capture_output=True,
        text=True,
        check=False,
        timeout=45,
    )
    try:
        rec = json.loads(p.stdout or "{}")
    except json.JSONDecodeError:
        rec = {"ok": False, "notes": (p.stderr or p.stdout or "bad json")[:400]}
    if not isinstance(rec, dict):
        return {"ok": False, "notes": "bad json"}
    return rec


def chat(prompt: str) -> str:
    body = json.dumps(
        {
            "model": "local/code",
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": 512,
            "temperature": 0.2,
        }
    ).encode()
    req = urllib.request.Request(
        f"{LOCALAI}/v1/chat/completions",
        data=body,
        headers={
            "Content-Type": "application/json",
            **({"Authorization": f"Bearer {localai_key()}"} if localai_key() else {}),
        },
    )
    with urllib.request.urlopen(req, timeout=180) as resp:
        data = json.load(resp)
    text = str(((data.get("choices") or [{}])[0].get("message") or {}).get("content") or "")
    append_chat(prompt, text, "local/code")
    return text


def proxy_eligible(path: str) -> bool:
    """Default-deny membership test for the upstream proxy.

    /api/apply is excluded even though dispatch_api_post never lets a
    request reach here for that path -- this is the independent second
    guard, not the only one.
    """
    if path == "/api/apply":
        return False
    return path in PROXY_ALLOW


def proxy_upstream(
    method: str,
    path_qs: str,
    body: bytes | None = None,
) -> tuple[int, bytes]:
    """Homelab UI → prime GPU agent, allowlisted routes only.

    Why: cards are inference providers only. Never relays the caller's
    credentials -- the client's Authorization header is never read here.
    Attaches a downstream-scoped bearer minted server-side (CSD_UPSTREAM_TOKEN,
    set from env at service start via `secret exec`) when one is configured;
    otherwise no Authorization header is sent at all.
    """
    headers: dict[str, str] = {}
    if body is not None:
        headers["Content-Type"] = "application/json"
    if UPSTREAM_TOKEN:
        headers["Authorization"] = f"Bearer {UPSTREAM_TOKEN}"
    req = urllib.request.Request(
        UPSTREAM + path_qs,
        data=body,
        method=method,
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read()
    except OSError as exc:
        return 502, json.dumps({"error": "prime agent down", "detail": str(exc)[:200]}).encode()


def dispatch_api_get(apipath: str, query: str) -> tuple[int, bytes]:  # noqa: PLR0911
    """Route one GET /api/* request. Pure function so proxy/auth order is testable."""
    if UPSTREAM:
        if not proxy_eligible(apipath):
            return 404, b'{"error":"not found"}'
        qs = apipath + (("?" + query) if query else "")
        return proxy_upstream("GET", qs)
    if apipath.startswith("/api/status"):
        return 200, json.dumps(snapshot()).encode()
    if apipath.startswith("/api/sessions"):
        q = parse_qs(query)
        sid = (q.get("id") or [""])[0]
        body = load_session(sid) if sid else {"sessions": list_sessions()}
        return 200, json.dumps(body).encode()
    if apipath.startswith("/api/comfy/list-workflows"):
        q = parse_qs(query)
        src = (q.get("source") or ["catalog"])[0]
        return 200, json.dumps(comfy_tool("list-workflows", {"source": src})).encode()
    if apipath.startswith("/api/comfy/prompt-status"):
        q = parse_qs(query)
        pid = (q.get("prompt_id") or [""])[0]
        return 200, json.dumps(comfy_tool("prompt-status", {"prompt_id": pid})).encode()
    hit = handle_lab("GET", apipath, _qs_payload(query))
    if hit is not None:
        code, rec = hit
        return code, json.dumps(rec).encode()
    return 404, b'{"error":"not found"}'


def dispatch_api_post(  # noqa: PLR0911
    postpath: str, auth_header: str, raw_in: bytes
) -> tuple[int, bytes]:
    """Route one POST /api/* request. Pure function so proxy/auth order is testable.

    /api/apply is handled here, unconditionally, before UPSTREAM is even
    consulted -- it never reaches proxy_upstream, regardless of whether this
    node is proxying. That is the OD-2 fix: apply auth used to run only in
    the branch taken when UPSTREAM was unset, so a proxying node relayed the
    client's raw Authorization header upstream for /api/apply without ever
    calling check_apply_auth.
    """
    if postpath == "/api/apply":
        if not check_apply_auth(auth_header):
            return 401, b'{"error":"unauthorized"}'
        try:
            payload = json.loads(raw_in or b"{}")
        except json.JSONDecodeError:
            payload = {}
        if not isinstance(payload, dict):
            payload = {}
        rec = http_apply(
            str(payload.get("worktree") or ""),
            str(payload.get("path") or ""),
            str(payload.get("content") or ""),
        )
        return (200 if rec.get("ok") else 400), json.dumps(rec).encode()
    if UPSTREAM:
        if not proxy_eligible(postpath):
            return 404, b'{"error":"not found"}'
        return proxy_upstream("POST", postpath, raw_in)
    try:
        payload = json.loads(raw_in or b"{}")
    except json.JSONDecodeError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    hit = handle_lab("POST", postpath, payload)
    if hit is not None:
        code, rec = hit
        return code, json.dumps(rec).encode()
    if postpath == "/api/steer":
        return 200, json.dumps(write_steer(**payload)).encode()
    if postpath == "/api/spawn":
        rec = spawn_alias(
            str(payload.get("alias") or "local/code"), str(payload.get("why") or "lab")
        )
        return 200, json.dumps(rec).encode()
    if postpath == "/api/chat":
        text = chat(str(payload.get("prompt") or ""))
        return 200, json.dumps({"content": text}).encode()
    if postpath == "/api/comfy/list-workflows":
        return 200, json.dumps(comfy_tool("list-workflows", payload)).encode()
    if postpath == "/api/comfy/queue-prompt":
        return 200, json.dumps(comfy_tool("queue-prompt", payload)).encode()
    if postpath == "/api/comfy/prompt-status":
        return 200, json.dumps(comfy_tool("prompt-status", payload)).encode()
    if postpath == "/api/comfy/flux-klein-4b":
        return 200, json.dumps(comfy_tool("flux-klein-4b", payload)).encode()
    return 404, b'{"error":"not found"}'


def serve(port: int) -> None:
    class H(BaseHTTPRequestHandler):
        def log_message(self, fmt: str, *args: object) -> None:
            return

        def _send(self, code: int, raw: bytes, ctype: str = "application/json") -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_GET(self) -> None:
            path = urlparse(self.path).path
            if path in ("/", "/lab", "/lab/"):
                body = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            parsed = urlparse(self.path)
            apipath = parsed.path[4:] if parsed.path.startswith("/lab/") else parsed.path
            code, raw = dispatch_api_get(apipath, parsed.query)
            self._send(code, raw)

        def do_POST(self) -> None:
            n = int(self.headers.get("Content-Length") or "0")
            raw_in = self.rfile.read(n)
            postpath = urlparse(self.path).path
            if postpath.startswith("/lab/"):
                postpath = postpath[4:]
            code, raw = dispatch_api_post(postpath, self.headers.get("Authorization") or "", raw_in)
            self._send(code, raw)

    bind = lab_bind()
    httpd = ThreadingHTTPServer((bind, port), H)
    print(f"csd-lab-console http://{bind}:{port}/lab")
    httpd.serve_forever()


