    print("=== akula-prime 3090 ===")
    print(s.get("prime_smi"))
    print("localai", s.get("localai_container"), s.get("localai"))
    feed = s.get("feed") or {}
    print("loaded prime", [x.get("alias") for x in (feed.get("prime") or {}).get("loaded") or []])
    print("=== gpu5080 ===")
    print(s.get("gpu5080_smi"))
    print(
        "lock",
        s.get("gpu5080_lock"),
        "runner",
        s.get("gpu5080_runner"),
        "comfy",
        s.get("gpu5080_comfy"),
    )
    print("loaded 5080", [x.get("alias") for x in (feed.get("gpu5080") or {}).get("loaded") or []])
    print("=== gpu5080-1080ti ===")
    print((feed.get("gpu5080_1080ti") or {}).get("smi") or s.get("guest_smi"))
    print(
        "guest_ip",
        (feed.get("gpu5080_1080ti") or {}).get("guest_ip"),
        "live",
