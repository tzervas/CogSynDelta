def sh(args: list[str], timeout: int = 20) -> str:
    p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    return (p.stdout or p.stderr or "").strip()


def ssh_5080(cmd: str) -> str:
    return sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", GPU5080, cmd])


COMFY_STATUS_CMD = (
    "systemctl is-enabled akula-comfyui.service 2>/dev/null || echo unknown; "
    "grep -qs akula-comfyui-locked "
    "/etc/systemd/system/akula-comfyui.service.d/gpu5080-lock.conf "
    "&& echo wrap-ready || echo wrap-missing"
)


def comfy_lab_field(enabled: str, wrap_ready: bool) -> str:
    """Map systemd is-enabled + lock wrap to the lab comfy field.

    Args:
        enabled: ``systemctl is-enabled`` stdout (generated/enabled/masked).
        wrap_ready: True when ExecStart drop-in is ``akula-comfyui-locked``.

    Returns:
        ``masked``, ``wrapped``, or the raw enabled string.

    Why: Quadlets report ``generated``. Mask is not the scheduler once the
    gpu5080-lock wrap is live. Operator mask still wins if systemd is masked.
    """
    raw = (enabled or "").strip()
    low = raw.lower()
    if "masked" in low:
        return "masked"
    if wrap_ready:
        return "wrapped"
    return raw or "unknown"


def parse_comfy_ssh(raw: str) -> str:
    """Parse gpu5080 comfy SSH blob into the lab status field.

    Args:
        raw: is-enabled line plus wrap-ready/wrap-missing.

    Returns:
        Lab comfy field (``wrapped`` / ``masked`` / raw systemd).
    """
    lines = [ln.strip() for ln in (raw or "").splitlines() if ln.strip()]
    enabled = lines[0] if lines else ""
    wrap_ready = any("wrap-ready" in ln.lower() for ln in lines)
    return comfy_lab_field(enabled, wrap_ready)


def ssh_guest(cmd: str, host: str | None = None) -> str:
    """Guest nvidia-smi when SSH works. Empty string on failure.

    Why: 1080 Ti is VFIO on gpu5080; host smi is 5080-only. Try the live
    guest_ip (catalog 192.168.1.243) once. Do not hang the 2s lab refresh.
    """
    raw = (host or GUEST_SSH or GUEST_IP or "").strip()
    if not raw:
        return ""
    target = raw if not raw[0].isdigit() else f"tzervas@{raw}"
    try:
        p = subprocess.run(
            ["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target, cmd],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if p.returncode != 0:
        return ""
    return (p.stdout or "").strip()


def localai_key() -> str:
    return os.environ.get("LOCALAI_API_KEY") or os.environ.get("API_KEY") or ""


def _read_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


def _latest_queue() -> dict:
    """Running job, else newest result. Why: feed shows thinking, not catalog."""
    if not QUEUE_DIR.is_dir():
        return {}
    running: dict = {}
    newest: tuple[float, dict] | None = None
    for path in QUEUE_DIR.glob("*.json"):
        rec = _read_json(path)
        if not rec:
            continue
        mtime = path.stat().st_mtime
        if rec.get("status") == "running":
            running = rec
        if newest is None or mtime > newest[0]:
            newest = (mtime, rec)
    if running:
        return running
    return newest[1] if newest else {}


def _latest_autodev() -> dict:
    if not AUTODEV_OUT.is_dir():
        return {}
    files = list(AUTODEV_OUT.glob("*.json"))
    if not files:
        return {}
    return _read_json(max(files, key=lambda p: p.stat().st_mtime))


def _files_touched(*recs: dict) -> list[str]:
    """Unique applied paths from heartbeat last / autodev-out."""
    out: list[str] = []
    seen: set[str] = set()
    for rec in recs:
        if not isinstance(rec, dict):
            continue
        applied = rec.get("applied") if isinstance(rec.get("applied"), dict) else {}
        extra = rec.get("files") if isinstance(rec.get("files"), list) else []
        applied_files = applied.get("files") if isinstance(applied.get("files"), list) else []
        candidates = (
            rec.get("path"),
            applied.get("path"),
            applied.get("wrote"),
            *extra,
            *applied_files,
        )
        for raw in candidates:
            name = str(raw or "").strip()
            if not name or name in seen:
                continue
            seen.add(name)
            out.append(name)
            if len(out) >= 24:
                return out
    return out


def _pytest_rc(*recs: dict) -> int | None:
    """Forgejo/local pytest rc when present; else map required_succeeded."""
    found: int | None = None
    fallback: int | None = None
    for rec in recs:
        if not isinstance(rec, dict):
            continue
        applied = rec.get("applied") if isinstance(rec.get("applied"), dict) else {}
        pytest_rec = rec.get("pytest") if isinstance(rec.get("pytest"), dict) else {}
        for src in (rec, applied, pytest_rec):
            if src.get("pytest_rc") is not None:
                found = int(src["pytest_rc"])
                break
            if src.get("rc") is not None and src is pytest_rec:
                found = int(src["rc"])
                break
        if found is not None:
            break
        if rec.get("required_succeeded") is True:
            found = 0
            break
        if rec.get("required_ran") is True:
            found = 1
            break
        if fallback is None and rec.get("ok") is True:
            fallback = 0
        elif fallback is None and rec.get("ok") is False:
            fallback = 1
    return found if found is not None else fallback


def _last_error(last: dict, aout: dict) -> str:
    """Prefer last.error, then apply/git/pr/skipped."""
    applied = last.get("applied") if isinstance(last.get("applied"), dict) else {}
    a_applied = aout.get("applied") if isinstance(aout.get("applied"), dict) else {}
    git = last.get("git") if isinstance(last.get("git"), dict) else {}
    pr = last.get("pr") if isinstance(last.get("pr"), dict) else {}
    for raw in (
        last.get("error"),
        applied.get("error"),
        a_applied.get("error"),
        git.get("error"),
        pr.get("error"),
        last.get("skipped"),
        aout.get("skipped"),
    ):
        if raw:
            return str(raw)[:240]
    return ""


def _receipt_5080(snap: dict) -> dict:
    """5080 lock/comfy/helper receipt for the GPUs tab. Not an LLM think."""
    plan = _read_json(GPU_PLAN)
    gpu = plan.get("gpu5080") if isinstance(plan.get("gpu5080"), dict) else {}
    lock = str(snap.get("gpu5080_lock") or gpu.get("lock") or "").strip()
    comfy = str(snap.get("gpu5080_comfy") or gpu.get("comfy") or "").strip()
    runner = str(snap.get("gpu5080_runner") or "").strip()
    receipt = (
        f"lock={lock or 'unknown'} comfy={comfy or 'unknown'} "
        f"runner={runner or 'n/a'} helper_ok={gpu.get('helper_ok')} "
        f"gguf={gpu.get('gguf_count')} role={gpu.get('role') or 'exclusive-cuda'}"
    )
    busy = bool(lock) and "idle" not in lock.lower()
    qjob = _latest_queue()
    kind = str(qjob.get("kind") or "")
    hostish = str(qjob.get("alias") or "") + str(qjob.get("host") or "")
    if qjob.get("status") in {"running", "queued"} and (
        kind in {"cuda", "helper", "gpu-ci", "test"} or "5080" in hostish
    ):
        return {
            "phase": "in-flight",
            "alias": qjob.get("alias") or "gpu5080",
            "prompt": str(qjob.get("prompt") or receipt)[:2000],
            "text": receipt[:2000],
            "goal": "exclusive-cuda",
        }
    return {
        "phase": "in-flight" if busy else "cuda",
        "alias": "gpu5080",
        "prompt": receipt[:2000],
        "text": receipt[:2000],
        "goal": "exclusive-cuda",
    }


def _thinking_1080ti(loaded: list, ti: dict) -> dict:
    """1080 Ti retrieve-index-light loaded/thinking. Never 5080 lock."""
    aliases = [str(x.get("alias")) for x in loaded if isinstance(x, dict) and x.get("alias")]
    live = bool(ti.get("live"))
    guest = str(ti.get("guest_ip") or GUEST_IP)
    rag = str(ti.get("rag") or "retrieve-index-light")
    if aliases:
        body = "loaded " + " ".join(aliases) + f" rag={rag} guest={guest}"
        return {
            "phase": "in-flight" if live else "retrieve-index-light",
            "alias": aliases[0],
            "prompt": body[:2000],
            "text": body[:2000],
            "goal": rag,
        }
    body = f"guest_ip={guest} live={live} rag={rag} loaded=none"
    return {
        "phase": "retrieve-index-light",
        "alias": None,
        "prompt": body[:2000],
        "text": body[:2000],
        "goal": rag,
    }


def autodev_now() -> dict:
    """Live Autodev pane: think text, in-flight prompt, files, pytest rc.

    Why: the Autodev tab must show what local/code is doing now, not a
    ticks JSON dump. Goals board stays on GET /api/goals.
    """
    qjob = _latest_queue()
    aout = _latest_autodev()
    hb = _read_json(HEARTBEAT)
    last = hb.get("last") if isinstance(hb.get("last"), dict) else {}
    inflight = ""
    phase = "last"
    if qjob.get("status") == "running":
        inflight = str(qjob.get("prompt") or "")[:2000]
        phase = "in-flight"
    elif qjob.get("status") == "queued":
        inflight = str(qjob.get("prompt") or "")[:2000]
        phase = "queued"
    text = str(aout.get("text") or qjob.get("result") or "")[:4000]
    ok = last.get("ok")
    if ok is None:
        ok = aout.get("ok")
    return {
        "phase": phase,
        "goal": str(last.get("goal") or aout.get("goal") or hb.get("next_goal") or "")[:240],
        "prompt": inflight,
        "inflight": inflight,
        "text": text,
        "files": _files_touched(last, aout),
        "pytest_rc": _pytest_rc(last, aout),
        "ok": ok,
        "error": _last_error(last, aout),
        "alias": qjob.get("alias") or "local/code",
    }


def loaded_only() -> dict:
    """Currently placed aliases from the router, expired dropped."""
    st = _read_json(ROUTER_STATE)
    now = time.time()
    prime: list[dict] = []
    gpu: list[dict] = []
    ti: list[dict] = []
    for alias, rec in (st.get("resident") or {}).items():
        if not isinstance(rec, dict):
            continue
        if float(rec.get("until") or 0) <= now:
            continue
        item = {"alias": alias, **rec}
        host = rec.get("host")
        if host == "gpu5080-1080ti":
            ti.append(item)
        elif host == "gpu5080":
            gpu.append(item)
        else:
            prime.append(item)
    return {
        "prime": prime,
        "gpu5080": gpu,
        "gpu5080-1080ti": ti,
        "parked": st.get("parked") or {},
    }


def _mib_to_gib(mib: int) -> float:
    return round(mib / 1024, 1)


def live_pool() -> dict:
    """Sum live model-router VRAM for the pool tab.

    Why: the 24+16 GiB default (39331 MiB) ignored the live 1080 Ti.
    combined_mib is catalog vram_mib of live hosts; usable is safeguard_mib.

    Returns:
        Pool dict with combined_mib, usable_mib, cards, and GiB fields.
    """
    cat = _read_json(ROUTER_JSON)
    hosts = cat.get("hosts") if isinstance(cat.get("hosts"), dict) else {}
    cards: list[dict] = []
    combined = 0
    usable = 0
    for name in ("akula-prime", "gpu5080", "gpu5080-1080ti"):
        spec = hosts.get(name)
        if not isinstance(spec, dict):
            continue
        if spec.get("live") is False or spec.get("installed") is False:
            continue
        if name == "gpu5080-1080ti" and spec.get("live") is not True:
            continue
        vram = int(spec.get("vram_mib") or 0)
        safeguard = int(spec.get("safeguard_mib") or vram)
        combined += vram
        usable += safeguard
        cards.append(
            {
                "id": name,
                "gpu": spec.get("gpu"),
                "vram_mib": vram,
                "safeguard_mib": safeguard,
                "gib": _mib_to_gib(vram),
                "usable_gib": _mib_to_gib(safeguard),
                "live": True,
            }
        )
    cat_pool = cat.get("pool") if isinstance(cat.get("pool"), dict) else {}
    return {
        "combined_mib": combined,
        "usable_mib": usable,
        "combined_gib": _mib_to_gib(combined),
        "usable_gib": _mib_to_gib(usable),
        "cards": cards,
        "enabled": bool(cat_pool.get("enabled")),
        "heterogeneous": True,
        "not_mig": True,
        "live_1080ti": any(c.get("id") == "gpu5080-1080ti" for c in cards),
    }


def live_feed(snap: dict) -> dict:
    """Three-host live pane: loaded models, activity, honest latent note."""
    loaded = loaded_only()
    qjob = _latest_queue()
    aout = _latest_autodev()
    thinking = None
    if qjob.get("status") == "running":
        thinking = {
            "phase": "in-flight",
            "alias": qjob.get("alias"),
            "prompt": str(qjob.get("prompt") or "")[:2000],
        }
    elif qjob.get("result") or aout.get("text"):
        thinking = {
            "phase": "last",
            "alias": qjob.get("alias") or "local/code",
            "text": str(qjob.get("result") or aout.get("text") or "")[:4000],
            "goal": aout.get("goal"),
        }
    cluster = snap.get("cluster") if isinstance(snap.get("cluster"), dict) else {}
    ti = cluster.get("gpu5080_1080ti") if isinstance(cluster.get("gpu5080_1080ti"), dict) else {}
    pool = live_pool()
    return {
        "prime": {
            "gpu": "RTX 3090 Ti Ampere sm_86",
            "role": (cluster.get("prime") or {}).get("role") or "autodev-local-code",
            "smi": snap.get("prime_smi"),
            "loaded": loaded["prime"],
            "thinking": thinking,
            "latent": {
                "kind": "kv-occupancy",
                "note": (
                    "GGUF decode has no public latent hook. VRAM used is "
                    "weights+KV. CSD region latents are not in this console."
                ),
            },
        },
        "gpu5080": {
            "gpu": "RTX 5080 Blackwell sm_120",
            "role": (cluster.get("gpu5080") or {}).get("role") or "chat-comfy",
            "smi": snap.get("gpu5080_smi"),
            "lock": snap.get("gpu5080_lock"),
            "comfy": snap.get("gpu5080_comfy"),
            "loaded": loaded["gpu5080"],
            "thinking": _receipt_5080(snap),
            "latent": {
                "kind": "embed-or-cuda",
                "note": (
                    "No LLM thinking on CUDA jobs. Embed probe appears when "
                    "a helper is physically loaded (gguf_count>0)."
                ),
            },
        },
        "gpu5080_1080ti": {
            "gpu": "GTX 1080 Ti Pascal sm_61",
            "role": ti.get("role") or "retrieve-index-light",
            "smi": snap.get("guest_smi") or snap.get("gpu5080_1080ti_smi"),
            "loaded": loaded.get("gpu5080-1080ti") or [],
            "thinking": _thinking_1080ti(loaded.get("gpu5080-1080ti") or [], ti),
            "guest_ip": ti.get("guest_ip") or GUEST_IP,
            "live": bool(ti.get("live", pool.get("live_1080ti"))),
            "group": ti.get("group") or "akula-rag",
            "path": ti.get("path") or "lab.gpu5080.index.1080ti",
            "rag": ti.get("rag") or "retrieve-index-light",
            "latent": {
                "kind": "retrieve-index-light",
                "note": (
                    "RAG/embed on Pascal. Not a 5080 substitute. No PoC CUDA, "
                    "FP8/FP4, dual-14B, or llama.cpp RPC Stage B."
                ),
            },
        },
        "pool": {
            **pool,
            "parked": loaded["parked"],
            "mode": "place-then-pool",
            "mix": "single-or-mix when Stage B RPC is enabled",
            "note": (
                "Unified pool tab. Combined is live catalog VRAM "
                "(3090+5080+1080 Ti when live), not a 24+16 default. "
                "llama.cpp RPC is specified, not enabled."
            ),
        },
        "cluster": cluster,
    }


def cluster_snapshot() -> dict:
    """LAN cluster including 1080 Ti guest IP when the VFIO guest is live.

    Why: lab UI and autodev must see gpu5080 `.251` and a real guest IP (or
    none). Do not invent `.252` or mark live without nvidia-smi / domifaddr.
    """
    cat = _read_json(ROUTER_JSON)
    hosts = cat.get("hosts") or {}
    stub = hosts.get("gpu5080-1080ti")
    if not isinstance(stub, dict):
        stub = (cat.get("future_hosts") or {}).get("gpu5080-1080ti")
    if not isinstance(stub, dict):
        stub = {}
    raw = ssh_5080("virsh domifaddr gpu5080-1080ti-rag 2>/dev/null || true")
    guest_ip = None
    for match in GUEST_IP_RE.finditer(raw or ""):
        ip = match.group(1)
        if ip not in {GPU5080_IP, "192.168.1.255", "192.168.1.0"}:
            guest_ip = ip
            break
    catalog_guest = stub.get("guest_ip")
    if guest_ip is None and isinstance(catalog_guest, str) and catalog_guest.strip():
        guest_ip = catalog_guest.strip()
    live = bool(stub.get("live"))
    rag = "retrieve-index-light" if live else "5080-embed-or-prime until live=true"
    prime_spec = hosts.get("akula-prime") if isinstance(hosts.get("akula-prime"), dict) else {}
    gpu_spec = hosts.get("gpu5080") if isinstance(hosts.get("gpu5080"), dict) else {}
    backends = [
        {
            "id": "akula-prime",
            "gpu": prime_spec.get("gpu") or "RTX 3090 Ti",
            "arch": prime_spec.get("arch"),
            "sm": prime_spec.get("sm"),
            "vram_mib": prime_spec.get("vram_mib"),
            "host_ip": PRIME_IP,
            "live": True,
            "group": "csd-autodev",
