th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--dim);padding:8px 10px;border-bottom:1px solid var(--line);font-weight:600}
td{padding:9px 10px;border-bottom:1px solid var(--line)}
tr:hover td{background:#1b1f28}
.pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:11px;font-weight:600}
.pass{background:rgba(63,185,80,.15);color:var(--ok)}
.fail{background:rgba(248,81,73,.15);color:var(--bad)}
.arch{color:var(--dim);font-size:12px}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.metrics span{display:inline-block;margin-right:12px;color:var(--dim);font-size:12px}
.metrics b{color:var(--fg);font-weight:600}
.spark{display:inline-flex;align-items:flex-end;gap:2px;height:18px}
.spark i{width:4px;background:var(--accent);border-radius:1px;min-height:2px}
.empty{color:var(--dim);padding:30px 0}
.wrap{overflow-x:auto}
</style></head><body>
<header><h1>Model Pipeline Console</h1>
<span class="sub" id="sub">loading…</span></header>
<main>
<h2>Fleet</h2><div class="grid" id="fleet"></div>
<h2>Pipelines</h2><div class="wrap"><table id="tbl">
<thead><tr><th>Project</th><th>Component</th><th>Stage</th><th>Architecture</th><th>Gates</th><th>Metrics</th><th>Trend</th><th>Runs</th><th>When</th></tr></thead>
<tbody></tbody></table></div>
<div class="empty" id="empty" hidden>No receipts found under the configured roots.</div>
</main>
<script>
const fmt = v => typeof v !== 'number' ? String(v) : (Math.abs(v) >= 100 ? v.toFixed(0) : v.toFixed(4));
function spark(vals){
  if(!vals || vals.length < 2) return '';
  const ok = vals.filter(v => typeof v === 'number');
  if(ok.length < 2) return '';
  const lo = Math.min(...ok), hi = Math.max(...ok), span = (hi - lo) || 1;
  return '<span class="spark">' + ok.map(v =>
    `<i style="height:${3 + 15 * (v - lo) / span}px"></i>`).join('') + '</span>';
}
async function load(){
  const [rows, fleet] = await Promise.all([
    fetch('api/pipelines').then(r => r.json()),
    fetch('api/fleet').then(r => r.json()),
  ]);
  const f = document.getElementById('fleet');
  f.innerHTML = (fleet.gpus||[]).map(g =>
    `<div class="card"><div class="k">${g.name}</div><div class="v">${g.util}%</div>
     <div class="bar"><i style="width:${Math.round(100*g.mem_used/g.mem_total)}%"></i></div>
     <div class="sub">${(g.mem_used/1024).toFixed(1)} / ${(g.mem_total/1024).toFixed(0)} GiB</div></div>`
  ).join('') + (fleet.storage||[]).map(s =>
    `<div class="card"><div class="k">${s.path}</div><div class="v">${s.used_pct}%</div>
     <div class="bar"><i style="width:${s.used_pct}%"></i></div>
     <div class="sub">${s.free_gb} GB free of ${s.total_gb}</div></div>`
  ).join('');
  const tb = document.querySelector('#tbl tbody');
  document.getElementById('empty').hidden = rows.length > 0;
  tb.innerHTML = rows.map(r => {
    const gates = Object.entries(r.gates||{}).map(([k,v]) =>
      `<span class="pill ${v?'pass':'fail'}">${k}</span>`).join(' ') || '<span class="arch">none</span>';
    const mets = Object.entries(r.metrics||{}).slice(0,4).map(([k,v]) => {
      const b = (r.baseline||{})[k];
      return `<span>${k} <b>${fmt(v)}</b>${b!==undefined?` <span class="arch">← ${fmt(b)}</span>`:''}</span>`;
    }).join('');
    return `<tr><td>${r.project}</td><td><b>${r.component}</b></td><td>${r.stage}</td>
      <td class="arch">${r.architecture||'—'}</td><td>${gates}</td>
      <td class="metrics">${mets}</td><td>${spark(r.trend)}</td>
      <td>${r.runs}</td><td class="mono arch">${(r.when||'').replace('T',' ').replace('Z','')}</td></tr>`;
  }).join('');
  document.getElementById('sub').textContent =
    `${rows.length} pipeline(s) · ${rows.filter(r=>r.passed).length} passing · updated ${new Date().toLocaleTimeString()}`;
}
load(); setInterval(load, 15000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    """Read-only JSON API plus the dashboard page."""

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, payload: object) -> None:
        self._send(200, json.dumps(payload, default=str).encode(), "application/json")

    def do_GET(self) -> None:
        path = self.path.split("?")[0].rstrip("/") or "/"
        # Tolerate being mounted under a prefix by a reverse proxy.
        for prefix in ("/lab/pipelines", "/pipelines"):
            if path.startswith(prefix):
                path = path[len(prefix) :] or "/"
                break
        if path in ("/", "/index.html"):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif path == "/api/pipelines":
            self._json(summarise(load_all(RECEIPT_ROOTS)))
        elif path == "/api/runs":
            self._json(
                [
                    {
                        "project": r.producer.project,
                        "component": r.producer.component,
                        "architecture": r.producer.architecture,
                        "stage": r.stage,
                        "metrics": r.metrics,
                        "baseline": r.baseline,
                        "gates": r.gates,
                        "passed": r.passed,
                        "when": r.started_utc,
                        "seconds": r.seconds,
                        "artifacts": r.artifacts,
                        "detail": r.detail,
                    }
                    for r in load_all(RECEIPT_ROOTS)
                ]
            )
        elif path == "/metrics":
            body = prometheus_text(load_all(RECEIPT_ROOTS)).encode()
            self._send(200, body, "text/plain; version=0.0.4; charset=utf-8")
        elif path == "/api/fleet":
            self._json(fleet_state())
        elif path == "/api/health":
            self._json({"ok": True, "roots": [str(p) for p in RECEIPT_ROOTS]})
        else:
            self._send(404, b"not found", "text/plain")

    def log_message(self, *_args: object) -> None:
        """Silence per-request logging; systemd journal gets enough already."""


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--http", type=int, default=9121)
    ap.add_argument(
        "--bind",
        default=os.environ.get("PIPELINE_CONSOLE_BIND", "127.0.0.1"),
        help="loopback by default; a routable bind must be asked for explicitly",
    )
    ap.add_argument(
        "--receipt-root",
        action="append",
        default=[],
        help="repeatable; any directory of pipeline receipts, from any project",
    )
    ap.add_argument("--once", action="store_true", help="print the JSON summary and exit")
    args = ap.parse_args()

    roots = [Path(r) for r in (args.receipt_root or ["/akula-data/csd/receipts"])]
    RECEIPT_ROOTS.extend(roots)

    if args.once:
        print(json.dumps(summarise(load_all(roots)), indent=2, default=str))
        return 0

    srv = ThreadingHTTPServer((args.bind, args.http), Handler)
    print(f"model-pipeline-console on http://{args.bind}:{args.http}", flush=True)
    print(f"  roots: {', '.join(str(r) for r in roots)}", flush=True)
    with contextlib.suppress(KeyboardInterrupt):
        srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
