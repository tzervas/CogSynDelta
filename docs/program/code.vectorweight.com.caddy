# Append to /data/ingress/caddy/Caddyfile on homelab, then reload Caddy.
# Chat = same Open WebUI as ai.vectorweight.com (LocalAI local/code).
# /lab = csd-lab-console on akula-prime (GPU lock, steer, snapshot).

https://code.vectorweight.com {
  import tls_vectorweight
  encode gzip
  handle /lab* {
    reverse_proxy 192.168.1.98:9118 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      fail_duration 10s
    }
  }
  reverse_proxy akula-open-webui:8080 {
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
    flush_interval -1
    fail_duration 10s
  }
}

http://code.vectorweight.com {
  redir https://code.vectorweight.com{uri} permanent
}
