def _read(name: str) -> str:
    return (FN_DIR / name).read_text(encoding="utf-8")


def _admin_id(cur: sqlite3.Cursor, email: str) -> str:
    row = cur.execute(
        "SELECT id FROM user WHERE email = ? AND role = 'admin' LIMIT 1", (email,)
    ).fetchone()
    if row:
        return row[0]
    row = cur.execute(
        "SELECT id FROM user WHERE role = 'admin' ORDER BY created_at LIMIT 1"
    ).fetchone()
    if not row:
        raise SystemExit("no admin user in webui.db")
    return row[0]


def upsert_tool(
    cur: sqlite3.Cursor,
    *,
    tid: str,
    user_id: str,
    name: str,
    content: str,
    meta: dict,
    valves: dict,
    specs: list,
    now: int,
) -> None:
    exists = cur.execute("SELECT id FROM tool WHERE id = ?", (tid,)).fetchone()
    dumped = json.dumps(specs)
    if exists:
        cur.execute(
            """
            UPDATE tool
            SET name=?, content=?, specs=?, meta=?, valves=?, updated_at=?
            WHERE id=?
            """,
            (name, content, dumped, json.dumps(meta), json.dumps(valves), now, tid),
        )
        return
    cur.execute(
        """
        INSERT INTO tool
          (id, user_id, name, content, specs, meta, valves, updated_at, created_at)
        VALUES (?,?,?,?,?,?,?,?,?)
        """,
        (tid, user_id, name, content, dumped, json.dumps(meta), json.dumps(valves), now, now),
    )


def install(db: Path, email: str, lab_base: str, apply_token: str) -> None:
    conn = sqlite3.connect(str(db))
    cur = conn.cursor()
    admin = _admin_id(cur, email)
    now = int(time.time())
    upsert_tool(
        cur,
        tid="csd_autodev",
        user_id=admin,
        name="CSD autodev lab",
        content=_read("csd_autodev.py"),
        meta={
            "description": "Lab :9118 git/forgejo/steer/apply/gpu. Identity autodev. No cloud.",
        },
        valves={
            "lab_base": lab_base,
            "apply_token": apply_token,
            "timeout_s": 12.0,
        },
        specs=AUTODEV_SPECS,
        now=now,
    )
    conn.commit()
    conn.close()
    print(
        json.dumps(
            {
                "ok": True,
                "db": str(db),
                "admin": admin,
                "tools": ["csd_autodev"],
                "specs": [s["name"] for s in AUTODEV_SPECS],
                "lab_base": lab_base,
                "apply_token_set": bool(apply_token),
                "restart_needed": False,
                "notes": "Tools sqlite upsert; restart OWUI only if env changed",
            }
        )
    )


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--db", type=Path, required=True)
    p.add_argument("--email", default=ADMIN_EMAIL_DEFAULT)
    p.add_argument("--lab-base", default="http://192.168.1.98:9118")
    p.add_argument(
        "--apply-token-file",
        type=Path,
        default=Path("/akula-data/cabal/csd-apply.token"),
    )
    p.add_argument("--fn-dir", type=Path, default=None)
    args = p.parse_args()
    if args.fn_dir is not None:
        global FN_DIR
        FN_DIR = args.fn_dir
    token = ""
    if args.apply_token_file.is_file():
        token = args.apply_token_file.read_text(encoding="utf-8").strip()
    install(args.db, args.email, args.lab_base, token)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
