    }


def snapshot() -> dict:
    steer = {}
    if STEER.is_file():
        try:
            steer = json.loads(STEER.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            steer = {"error": "invalid json"}
    models: list[str] = []
    lai = "down"
    try:
        req = urllib.request.Request(
            f"{LOCALAI}/v1/models",
            headers={"Authorization": f"Bearer {localai_key()}"} if localai_key() else {},
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.load(resp)
        models = [m.get("id") for m in (data.get("data") or []) if m.get("id")]
        lai = "ok"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        lai = "unreachable"
    cluster = cluster_snapshot()
    guest_ip = None
    ti = cluster.get("gpu5080_1080ti") if isinstance(cluster.get("gpu5080_1080ti"), dict) else {}
    guest_raw = ti.get("guest_ip")
    if isinstance(guest_raw, str) and guest_raw.strip():
        guest_ip = guest_raw.strip()
    guest_smi = ""
    if ti.get("live") and guest_ip:
        guest_smi = ssh_guest(
            "nvidia-smi --query-gpu=name,memory.used,memory.free,utilization.gpu "
            "--format=csv,noheader",
            host=guest_ip,
        )
    out = {
        "prime_smi": sh(
            [
                "nvidia-smi",
                "--query-gpu=name,memory.used,memory.free,utilization.gpu",
                "--format=csv,noheader",
            ]
        ),
        "localai": lai,
        "models": models,
        "localai_container": sh(["docker", "inspect", "-f", "{{.State.Status}}", "akula-localai"]),
        "gpu5080_smi": ssh_5080(
            "nvidia-smi --query-gpu=name,memory.used,memory.free,utilization.gpu --format=csv,noheader"
        ),
        "gpu5080_lock": ssh_5080(
            "fuser /home/tzervas/akula-harness/state/gpu5080.lock 2>/dev/null || echo idle"
        ),
        "gpu5080_runner": ssh_5080("systemctl --user is-active forgejo-runner-gpu-tzervas.service"),
        "gpu5080_comfy": parse_comfy_ssh(ssh_5080(COMFY_STATUS_CMD)),
        "guest_smi": guest_smi,
        "gpu5080_1080ti_smi": guest_smi,
        "steer": steer,
        "cluster": cluster,
        "roles": cluster.get("roles") or {},
        "note": "autodev webapp on code.vectorweight.com; chat on ai.vectorweight.com",
        "links": {
            "lab": "https://code.vectorweight.com",
            "chat": "https://ai.vectorweight.com",
            "forgejo": "https://git.vectorweight.com/tzervas/CogSynDelta",
            "grafana": "https://grafana.vectorweight.com",
            "logs": "https://loki.vectorweight.com",
            "metrics": "https://vm.vectorweight.com",
            "status": "https://status.vectorweight.com",
        },
    }
    out["feed"] = live_feed(out)
    out["app"] = autodev_app()
    return out


def autodev_app() -> dict:
    """Queue, now-pane, ticks, and heartbeat last for the Autodev tab."""
    queue: list[dict] = []
    live: list[dict] = []
    if QUEUE_DIR.is_dir():
        files = sorted(QUEUE_DIR.glob("*.json"), key=lambda p: -p.stat().st_mtime)
        for path in files:
            if path.name.endswith(".result.json"):
                continue
            rec = _read_json(path)
            item = {
                "id": rec.get("id") or path.stem,
                "status": rec.get("status"),
                "kind": rec.get("kind"),
                "alias": rec.get("alias"),
                "prio": rec.get("prio"),
            }
            if rec.get("status") in {"queued", "running"}:
                item["prompt"] = str(rec.get("prompt") or "")[:2000]
            if item["status"] in {"queued", "running"}:
                live.append(item)
            elif len(queue) < 12:
                queue.append(item)
    goals = []
    if GOALS.is_file():
        goals = [ln for ln in GOALS.read_text(encoding="utf-8").splitlines() if "| G-" in ln][:24]
    ticks = []
    if AUTODEV_OUT.is_dir():
        files = sorted(AUTODEV_OUT.glob("*.json"), key=lambda p: -p.stat().st_mtime)[:8]
        for path in files:
            rec = _read_json(path)
            ok = rec.get("ok")
            if ok is None:
                ok = rec.get("rc") == 0
            ticks.append(
                {
                    "id": path.stem,
                    "goal": str(rec.get("goal") or "")[:120],
                    "ok": ok,
                    "rc": rec.get("rc"),
                    "pytest_rc": rec.get("pytest_rc"),
                    "applied": rec.get("applied"),
                    "files": _files_touched(rec),
                }
            )
    cat = _read_json(ROUTER_JSON)
    runtimes = {
        name: {
            "best_for": spec.get("best_for"),
            "image": spec.get("image"),
            "hosts": spec.get("hosts"),
        }
        for name, spec in (cat.get("runtimes") or {}).items()
    }
    hb = _read_json(HEARTBEAT)
    last = hb.get("last") if isinstance(hb.get("last"), dict) else {}
    aout = _latest_autodev()
    age = time.time() - float(hb.get("t") or 0) if hb else None
    heartbeat_last = {
        "goal": str(last.get("goal") or "")[:240],
        "ok": last.get("ok"),
        "error": _last_error(last, aout),
    }
    return {
        "queue_live": live,
        "queue_recent_done": queue,
        "queue": live or queue,
        "worker_live": bool(age is not None and age < 90),
        "worker_age_s": age,
        "goals": goals,
        "ticks": ticks,
        "now": autodev_now(),
        "heartbeat": {
            "t": hb.get("t"),
            "pid": hb.get("pid"),
            "live": bool(age is not None and age < 90),
            "identity": hb.get("identity") or "autodev",
            "next_goal": hb.get("next_goal"),
            "last": heartbeat_last,
        },
        "runtimes": runtimes,
        "parallel": "3090 text + 5080 CUDA/helpers at once; interned GEMM later",
    }


