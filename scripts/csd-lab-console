    )
    print(
        "loaded 1080ti",
        [x.get("alias") for x in (feed.get("gpu5080_1080ti") or {}).get("loaded") or []],
    )
    print("=== cluster ===")
    print(json.dumps(s.get("cluster") or {}, indent=2))
    print("=== steer ===")
    print(json.dumps(s.get("steer") or {}, indent=2))
    print(s.get("note"))


def write_steer(**fields: object) -> dict:
    cur: dict = {}
    if STEER.is_file():
        try:
            cur = json.loads(STEER.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            cur = {}
    cur.update({k: v for k, v in fields.items() if v is not None})
    STEER.parent.mkdir(parents=True, exist_ok=True)
    STEER.write_text(json.dumps(cur, indent=2) + "\n", encoding="utf-8")
    return cur


def list_sessions() -> list[dict]:
    """Historic lab chats (daily files) plus autodev ticks."""
    items: list[dict] = []
    if SESS_DIR.is_dir():
        for path in SESS_DIR.glob("chat-*.json"):
            rec = _read_json(path)
            turns = rec.get("turns") or []
            title = ""
            if turns:
                title = str(turns[0].get("prompt") or "")[:80]
            items.append(
                {
                    "id": path.stem,
                    "kind": "chat",
                    "t": path.stat().st_mtime,
                    "n": len(turns),
                    "title": title,
                }
            )
    if AUTODEV_OUT.is_dir():
        for path in AUTODEV_OUT.glob("*.json"):
            rec = _read_json(path)
            items.append(
                {
                    "id": f"autodev-{path.stem}",
                    "kind": "autodev",
                    "t": float(rec.get("t") or path.stat().st_mtime),
                    "n": 1,
                    "title": str(rec.get("goal") or path.stem)[:80],
                }
            )
    items.sort(key=lambda r: -float(r.get("t") or 0))
    return items[:200]


def load_session(sid: str) -> dict:
    """Load one historic session by id (chat-YYYY-MM-DD or autodev-TS)."""
    if sid.startswith("autodev-"):
        path = AUTODEV_OUT / f"{sid[len('autodev-') :]}.json"
        rec = _read_json(path)
        rec["id"] = sid
        rec["kind"] = "autodev"
        return rec
    if ".." in sid or "/" in sid:
        return {"error": "bad id"}
    rec = _read_json(SESS_DIR / f"{sid}.json")
    rec["id"] = sid
    rec["kind"] = "chat"
    return rec


def append_chat(prompt: str, reply: str, alias: str) -> None:
    """Append a lab chat turn to today's session file."""
    SESS_DIR.mkdir(parents=True, exist_ok=True)
    day = time.strftime("%Y-%m-%d")
    path = SESS_DIR / f"chat-{day}.json"
    rec = _read_json(path)
    if not rec:
        rec = {"id": f"chat-{day}", "kind": "chat", "turns": []}
    rec.setdefault("turns", []).append(
        {
            "t": time.time(),
            "alias": alias,
            "prompt": prompt,
            "reply": reply,
        }
    )
    path.write_text(json.dumps(rec, indent=2) + "\n", encoding="utf-8")


def apply_token() -> str:
    if os.environ.get("CSD_APPLY_TOKEN"):
        return os.environ["CSD_APPLY_TOKEN"].strip()
    if APPLY_TOKEN_FILE.is_file():
        return APPLY_TOKEN_FILE.read_text(encoding="utf-8").strip()
    return ""


def check_apply_auth(header: str) -> bool:
    """Bearer token compare. Why: worktree writes without SSH."""
    want = apply_token()
    if not want:
        return False
    got = header or ""
    if got.lower().startswith("bearer "):
        got = got[7:].strip()
    return hmac.compare_digest(got, want)


def http_apply(worktree: str, rel: str, content: str) -> dict:
    """Allowlisted worktree write. Never kang-main-wip."""
    dest = WORKTREES.get(worktree)
    if dest is None or not dest.is_dir():
        return {"ok": False, "error": f"unknown worktree {worktree}"}
    if dest.resolve() == PROTECTED_WT.resolve():
        return {"ok": False, "error": "refusing kang-main-wip"}
    rel = rel.lstrip("/")
    if ".." in Path(rel).parts or not rel.startswith(ALLOW_PREFIXES):
        return {"ok": False, "error": f"path not allowed: {rel}"}
    if len(content) > 400_000:
        return {"ok": False, "error": "content too large"}
    target = (dest / rel).resolve()
    if dest.resolve() not in target.parents:
        return {"ok": False, "error": "escaped worktree"}
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")
    return {"ok": True, "wrote": str(target)}


def _scrub(text: str) -> str:
    """Strip token-like assignments from CLI text. Never print secrets."""
    return re.sub(
        r"(?i)(token|bearer|authorization|api[_-]?key)\s*[:=]\s*\S+",
        r"\1=<redacted>",
        text,
    )


def _parse_last_json(text: str) -> dict:
    """Parse the last JSON object from CLI stdout."""
    blob = (text or "").strip()
    if not blob:
        return {}
    start = blob.rfind("{")
    if start >= 0:
        try:
            data = json.loads(blob[start:])
            if isinstance(data, dict):
                return data
        except json.JSONDecodeError:
            pass
    for line in reversed(blob.splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            data = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(data, dict):
            return data
    return {}


def _run_cli(argv: list[str], timeout: int = 90) -> tuple[int, str]:
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    out = _scrub((p.stdout or "").strip())
    err = _scrub((p.stderr or "").strip())
    text = out if out else err
    return p.returncode, text[:8000]


def _forgejo_argv(rest: list[str]) -> list[str]:
    """autodev Forgejo CLI; TOKEN from env or CSD vault. Never operator admin."""
    cli = str(FORGEJO_CLI)
    if os.environ.get("TOKEN") or os.environ.get("FORGEJO_TOKEN"):
        return [cli, *rest]
    return [SECRET_BIN, "exec", "TOKEN=git/autodev", "--", cli, *rest]


def _repo_ok(raw: str) -> str | None:
    name = raw if "/" in raw else f"tzervas/{raw}"
    if name not in FORGEJO_ALLOW:
        return None
    return name


def _as_int(val: object, default: int, lo: int, hi: int) -> int:
    try:
        n = int(val)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        n = default
    return max(lo, min(n, hi))


def lab_git(args: list[object]) -> dict:
    """JSON wrap of scripts/csd-autodev-git. Never GitHub. Never protected trunks."""
    if not args or not all(isinstance(a, str) for a in args):
        return {"ok": False, "rc": 2, "stdout": "args must be a string array"}
    argv = [str(a) for a in args]
    if any("github.com" in a.lower() for a in argv):
        return {"ok": False, "rc": 2, "stdout": "never GitHub"}
    if any(a == "-c" or a.startswith("--exec") or "credential" in a.lower() for a in argv):
        return {"ok": False, "rc": 2, "stdout": "refusing git config/credential args"}
    if argv[0] in {"push", "checkout", "switch", "merge", "rebase"}:
        for a in argv[1:]:
            for branch in PROTECTED_REFS:
                if a == branch or a.endswith(f":{branch}") or a.endswith(f"/{branch}"):
                    return {
                        "ok": False,
                        "rc": 2,
                        "stdout": f"refusing {argv[0]} {branch}",
                    }
    try:
        rc, text = _run_cli([str(GIT_CLI), *argv], timeout=120)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "rc": 1, "stdout": str(exc)[:400]}
    return {"ok": rc == 0, "rc": rc, "stdout": text}


def lab_gpu(refresh: bool = False) -> dict:
    """Wrap csd-gpu-plan. Prefer CSD_GPU_PLAN file to avoid extra SSH."""
    if not refresh:
        plan = _read_json(GPU_PLAN)
        if plan.get("akula-prime") is not None and plan.get("gpu5080") is not None:
            return plan
    try:
        rc, text = _run_cli([str(GPU_PLAN_CLI)], timeout=40)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)[:200]}
    data = _parse_last_json(text)
    if data.get("akula-prime") is not None:
        return data
    plan = _read_json(GPU_PLAN)
    if plan:
        return plan
    return {"ok": False, "error": text[:400], "rc": rc}


def lab_gpu_lock() -> dict:
    """Observe gpu5080.lock from the plan. Acquire/release is not here."""
    plan = lab_gpu(refresh=False)
    g = plan.get("gpu5080") if isinstance(plan.get("gpu5080"), dict) else {}
    return {
        "lock": str(g.get("lock") or "unknown"),
        "comfy": str(g.get("comfy") or "unknown"),
        "helper_ok": bool(g.get("helper_ok")),
    }


def lab_priority(action: str) -> dict:
    """Wrap csd-autodev-priority on|off|status. Never pause 3090 LocalAI."""
    if action not in {"on", "off", "status"}:
        return {"ok": False, "error": "action must be on|off|status"}
    try:
        _rc, text = _run_cli([str(PRIORITY_CLI), action], timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)[:200]}
    steer: dict = {}
    comfy = ""
    webui = ""
    for line in text.splitlines():
        if line.startswith("steer="):
            try:
                parsed = json.loads(line[6:])
            except json.JSONDecodeError:
                parsed = {}
            if isinstance(parsed, dict):
                steer = parsed
        elif line.startswith("comfy=") or line.startswith("comfy:"):
            comfy = line.split(":", 1)[-1].split("=", 1)[-1].strip()
        elif "webui" in line.lower():
            webui = line.strip()
    if not steer and STEER.is_file():
        steer = _read_json(STEER)
    return {"steer": steer, "comfy": comfy, "webui": webui}


def lab_loop(mode: str) -> dict:
    """Wrap csd-autodev-loop --once. Worker is systemd, not HTTP."""
    if mode == "worker":
        hb = _read_json(HEARTBEAT)
        last = hb.get("last") if isinstance(hb.get("last"), dict) else {}
        age = time.time() - float(hb.get("t") or 0) if hb.get("t") else None
        live = bool(age is not None and age < 90)
        return {
            "ok": live,
            "rc": 0 if live else 1,
            "goal": str(last.get("goal") or ""),
            "applied": last.get("applied") if isinstance(last.get("applied"), dict) else {},
            "out": "",
            "notes": ("worker is systemd csd-autodev-loop.service; HTTP does not spawn it"),
        }
    if mode != "once":
        return {
            "ok": False,
            "rc": 2,
            "goal": "",
            "applied": {},
            "out": "mode must be once|worker",
        }
    try:
        rc, text = _run_cli([str(LOOP_CLI), "--once"], timeout=300)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "rc": 1, "goal": "", "applied": {}, "out": str(exc)[:400]}
    rec = _parse_last_json(text)
    applied = rec.get("applied") if isinstance(rec.get("applied"), dict) else {}
    return {
        "ok": bool(rec.get("ok")) if rec else rc == 0,
        "rc": rc,
        "goal": str(rec.get("goal") or ""),
        "applied": applied,
        "out": str(rec.get("out") or text[:2000]),
    }


def lab_forgejo(cmd: str, payload: dict) -> dict:  # noqa: PLR0911
    """JSON wrap of csd-autodev-forgejo. Allowlisted repos only."""
    rest: list[str] = []
    timeout = 90
    if cmd == "whoami":
        rest = ["whoami"]
    elif cmd == "prs":
        repo = str(payload.get("repo") or "")
        if not _repo_ok(repo):
            return {
                "http": 400,
                "repo": repo,
                "pulls": [],
                "error": "repo not allowlisted",
            }
        limit = _as_int(payload.get("limit"), 20, 1, 100)
        rest = [
            "prs",
            repo,
            "--state",
            str(payload.get("state") or "open"),
            "--limit",
            str(limit),
        ]
    elif cmd == "pr-create":
        repo = str(payload.get("repo") or "")
        title = str(payload.get("title") or "")
        head = str(payload.get("head") or "")
        if not _repo_ok(repo) or not title or not head:
            return {"http": 400, "error": "repo, title, head required"}
        if head in PROTECTED_REFS:
            return {"http": 400, "error": f"refusing head {head}"}
        rest = [
            "pr-create",
            repo,
            title,
            head,
            "--base",
            str(payload.get("base") or "main"),
            "--body",
            str(payload.get("body") or ""),
        ]
    elif cmd == "status":
        repo = str(payload.get("repo") or "")
        sha = str(payload.get("sha") or "")
        if not _repo_ok(repo) or not sha:
            return {
                "http": 400,
                "state": "error",
                "checks": [],
                "error": "repo and sha required",
            }
        rest = ["status", repo, sha]
    elif cmd == "wait":
        repo = str(payload.get("repo") or "")
        sha = str(payload.get("sha") or "")
        if not _repo_ok(repo) or not sha:
            return {"http": 400, "state": "error", "error": "repo and sha required"}
        wait_t = _as_int(payload.get("timeout"), 1800, 1, 1800)
        poll = _as_int(payload.get("poll"), 30, 1, 120)
        rest = ["wait", repo, sha, "--timeout", str(wait_t), "--poll", str(poll)]
        timeout = wait_t + poll + 15
    elif cmd == "comment":
        repo = str(payload.get("repo") or "")
        body = str(payload.get("body") or "")
        number = payload.get("number")
        if not _repo_ok(repo) or not body or number is None:
            return {"http": 400, "ok": False, "error": "repo, number, body required"}
        rest = ["comment", repo, str(int(number)), body]
    elif cmd == "merge-gate":
        repo = str(payload.get("repo") or "")
        sha = str(payload.get("sha") or "")
        number = payload.get("number")
        if not _repo_ok(repo) or not sha or number is None:
            return {
                "ok": False,
                "state": "error",
                "merged": False,
                "required_ran": False,
                "required_succeeded": False,
                "notes": "repo, sha, number required",
            }
        rest = ["merge-gate", repo, sha, str(int(number))]
        timeout = 120
    else:
        return {"ok": False, "error": f"unknown forgejo cmd {cmd}"}
    try:
        rc, text = _run_cli(_forgejo_argv(rest), timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "http": 0, "error": str(exc)[:200]}
    rec = _parse_last_json(text)
    if not rec:
        rec = {"ok": rc == 0, "error": text[:400]}
    rec.setdefault("ok", rc == 0)
    return rec


def _qs_payload(query: str) -> dict:
    q = parse_qs(query)
    out: dict = {}
    for key, vals in q.items():
        if not vals:
            continue
        out[key] = vals[0]
    for key in ("limit", "number", "timeout", "poll"):
        if key in out:
            try:
                out[key] = int(out[key])
            except (TypeError, ValueError):
                out.pop(key, None)
    if "pause" in out:
        out["pause"] = str(out["pause"]).lower() in {"1", "true", "yes"}
    if "refresh" in out:
        out["refresh"] = str(out["refresh"]).lower() in {"1", "true", "yes"}
    if "autodev_priority" in out:
        out["autodev_priority"] = str(out["autodev_priority"]).lower() in {
            "1",
            "true",
            "yes",
        }
    return out


def _merged_p1_ids(text: str) -> set[str]:
    """IDs listed as merged in the Phase 1 board or GOALS.md."""
    found: set[str] = set()
    for line in text.splitlines():
        idx = line.lower().find("merged")
        if idx < 0:
            continue
        prefix = line[:idx]
        for match in re.finditer(r"P1-(\d+)\.\.P1-(\d+)", prefix):
            start, end = int(match.group(1)), int(match.group(2))
            for i in range(start, end + 1):
                found.add(f"P1-{i:02d}")
        for match in re.finditer(r"P1-\d+", prefix):
            found.add(match.group(0))
    return found


def _parse_phase1_board(text: str, next_goal: str) -> list[dict]:
    """Parse PHASE-1-TASK-BOARD.md sequenced rows into JSON."""
    merged = _merged_p1_ids(text)
    goals_text = GOALS.read_text(encoding="utf-8") if GOALS.is_file() else ""
    if goals_text:
        merged |= _merged_p1_ids(goals_text)
        for line in goals_text.splitlines():
            if "| met |" not in line:
                continue
            hit = re.search(r"P1-\d+", line)
            if hit:
                merged.add(hit.group(0))
    blocked = {"P1-05"}
    nxt = (next_goal or "").strip()
    rows: list[dict] = []
    for line in text.splitlines():
        match = re.match(
            r"^\|\s*`(P1-\d+)`\s*\|\s*([^|]*)\|\s*([^|]*)\|\s*([^|]*)\|\s*([^|]*)\|",
            line,
        )
        if not match:
            continue
        pid, depends, title, gate, alloc = (g.strip() for g in match.groups())
        if pid in blocked:
            status = "blocked"
        elif nxt and (pid == nxt or nxt.startswith(pid)):
            status = "next"
        elif pid in merged:
            status = "done"
        else:
            status = "open"
        branch = ""
        bm = re.search(r"`([^`]+)`\s*$", title)
        if not bm:
            bm = re.search(r"—\s*`([^`]+)`", title)
        if bm:
            branch = bm.group(1)
        rows.append(
            {
                "id": pid,
                "depends": depends,
                "title": title,
                "branch": branch,
                "acceptance": gate[:400],
                "allocation": alloc[:240],
                "status": status,
            }
        )
    return rows


def csd_vault_path() -> Path:
    """CSD vault only. Never the operator ~/.secrets or model vaults."""
    raw = os.environ.get("CSD_VAULT") or os.environ.get("SECRET_VAULT")
    path = Path(raw) if raw else Path("/akula-data/cabal/csd-vault")
    return path


def hf_autodev_gap() -> dict:
    """Live presence of hf/autodev without reading token bytes.

    Why: goals API must report mint HF when the CSD vault name is missing.
    Never copy gpu/huggingface-token. Never walk operator secrets.

    Returns:
        Dict with autodev bool, gap, mint steps, and private repo names.
    """
    vault = csd_vault_path()
    refused = vault.resolve() == OPERATOR_SECRETS.resolve()
    present = False
    if not refused and vault.is_dir():
        hf_dir = vault / "hf"
        if hf_dir.is_dir():
            present = any(
                p.is_file() and p.stat().st_size > 0 and p.name.startswith("autodev")
                for p in hf_dir.iterdir()
            )
    return {
        "autodev": present,
        "gap": None if present else "mint HF",
        "vault": "refused-operator-vault" if refused else str(vault),
        "mint": HF_MINT,
        "never_copy": "gpu/huggingface-token",
        "repos": [
            "tzervas/cogsyndelta-region-stream_vae-tiny",
            "tzervas/cogsyndelta-region-residual_mlp-tiny",
            "tzervas/cogsyndelta-region-route-tiny",
            "tzervas/cogsyndelta-tiny",
            "tzervas/cogsyndelta-small",
            "tzervas/cogsyndelta-medium",
        ],
        "publish": (
            "private tzervas/cogsyndelta-region-<name>-<size> then "
            "tzervas/cogsyndelta-<size> only after mint and a "
            "green receipt in benchmark_results/scale_ladder.json"
        ),
    }


def load_scale_ladder() -> dict:
    """Receipt file for ladder rungs. green=true is a Grafana sat only."""
    path = Path(os.environ.get("CSD_SCALE_LADDER") or str(SCALE_LADDER))
    rec = _read_json(path)
    rungs = rec.get("rungs") if isinstance(rec.get("rungs"), list) else []
    return {
        "ok": bool(rungs),
        "path": str(path),
        "schema": rec.get("schema"),
        "doc": rec.get("doc") or "docs/program/CSD-SCALE-LADDER.md",
        "grafana_sat": rec.get("grafana_sat") if isinstance(rec.get("grafana_sat"), dict) else {},
        "rungs": rungs,
        "any_green": any(bool(row.get("green")) for row in rungs if isinstance(row, dict)),
    }


def scale_ladder_prom() -> str:
    """Prometheus exposition from scale_ladder.json. 1 only if green is true."""
    rec = load_scale_ladder()
    lines = [
        "# HELP csd_scale_ladder_rung_green 1 when scale_ladder.json green is true",
        "# TYPE csd_scale_ladder_rung_green gauge",
    ]
    for row in rec.get("rungs") or []:
        if not isinstance(row, dict):
            continue
        n = int(row.get("n") or 0)
        size = re.sub(r"[^a-z0-9_]+", "", str(row.get("size") or "unknown").lower())
        val = 1 if row.get("green") is True else 0
        lines.append(f'csd_scale_ladder_rung_green{{rung="{n}",size="{size}"}} {val}')
    return "\n".join(lines) + "\n"


def need_grok_path() -> Path:
    """Return the ping mailbox path (CSD_GROK_NEED)."""
    return Path(os.environ.get("CSD_GROK_NEED", str(GROK_NEED)))


def cap_need_grok(rec: dict) -> dict:
    """Keep ping JSON at or under 2 KiB. Drop dumps, never transcripts."""
    out = {k: v for k, v in rec.items() if k not in PING_DROP}
    out["identity"] = "autodev"
    if out.get("need") is not True:
        return {"need": False}
    raw = json.dumps(out, separators=(",", ":")).encode()
    if len(raw) <= PING_MAX:
        return out
    out.pop("tried", None)
    raw = json.dumps(out, separators=(",", ":")).encode()
    if len(raw) <= PING_MAX:
        return out
    out.pop("paths", None)
    evidence = str(out.get("evidence") or "")
    while len(json.dumps(out, separators=(",", ":")).encode()) > PING_MAX:
        if len(evidence) > 40:
            evidence = evidence[: max(40, len(evidence) // 2)]
            out["evidence"] = evidence
            continue
        q = str(out.get("question") or "")
        if len(q) > 40:
            out["question"] = q[:40]
            continue
        break
    return out


def load_need_grok() -> dict:
    """Read ping mailbox plus file mtime. Missing file is need=false."""
    path = need_grok_path()
    rec = _read_json(path)
    mtime = path.stat().st_mtime if path.is_file() else 0.0
    return {
        "ok": True,
        "need": rec.get("need") is True,
        "identity": rec.get("identity") or "autodev",
        "question": rec.get("question") or "",
        "evidence": rec.get("evidence") or "",
        "goal": rec.get("goal") or "",
        "blocker": rec.get("blocker") or "",
        "paths": rec.get("paths") if isinstance(rec.get("paths"), list) else [],
        "tried": rec.get("tried") if isinstance(rec.get("tried"), list) else [],
        "t": rec.get("t"),
        "mtime": mtime,
        "path": str(path),
        "hosted_grok": False,
    }


def write_need_grok_mailbox(payload: dict) -> dict:
    """Write/merge ping mailbox. Never spawn grok. Cap 2 KiB.

    Why: GET/POST /api/grok-need only rewrite the file. Hosted Grok wakes
    when the operator opens a session after need=true.
    """
    path = need_grok_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    if payload.get("need") is not True:
        rec: dict = {"need": False}
        path.write_text(json.dumps(rec) + "\n", encoding="utf-8")
        rec.update({"ok": True, "mtime": path.stat().st_mtime, "hosted_grok": False})
        return rec
    cur = _read_json(path)
    merged = {**cur, **payload, "need": True, "identity": "autodev"}
    if not merged.get("t"):
        merged["t"] = int(time.time())
    rec = cap_need_grok(merged)
    path.write_text(json.dumps(rec) + "\n", encoding="utf-8")
    rec["ok"] = True
    rec["mtime"] = path.stat().st_mtime
    rec["hosted_grok"] = False
    return rec


def need_grok_prom() -> str:
    """Prometheus gauges from mailbox JSON and file mtime.

    Why: Grafana pages maintainers@ once when need=true. Mtime changes only
    when the file is rewritten, so loop ticks do not re-fire the alert.
    """
    rec = load_need_grok()
    need = 1 if rec.get("need") is True else 0
    mtime = int(rec.get("mtime") or 0)
    return (
        "# HELP csd_need_grok 1 when csd-need-grok.json need is true\n"
        "# TYPE csd_need_grok gauge\n"
        f'csd_need_grok{{identity="autodev"}} {need}\n'
        "# HELP csd_need_grok_mtime_seconds Unix mtime of the ping mailbox\n"
        "# TYPE csd_need_grok_mtime_seconds gauge\n"
        f"csd_need_grok_mtime_seconds {mtime}\n"
    )


def lab_metrics() -> str:
    """Lab /metrics: scale ladder plus need_grok. Never hosted Grok."""
    return scale_ladder_prom() + need_grok_prom()


def lab_goals() -> dict:
    """PHASE-1 board plus steer next_goal and autodev heartbeat.

    Why: the lab Goals/Todos tab must render from GET /api/goals JSON, not
    a second Open WebUI. Steer note/reasoning stay in CSD_STEER.

    Returns:
        Dict with ok, next_goal, steer, notes, reasoning, heartbeat, phase1,
        todos, scale_ladder, and hf (honest mint-HF gap when unminted).
    """
    steer = _read_json(STEER)
    next_goal = str(steer.get("next_goal") or "").strip()
    notes = str(steer.get("note") or steer.get("notes") or "")
    reasoning = str(steer.get("reasoning") or notes)
    board_text = PHASE1.read_text(encoding="utf-8") if PHASE1.is_file() else ""
    phase1 = _parse_phase1_board(board_text, next_goal)
    todos = [row for row in phase1 if row.get("status") in {"next", "open"}]
    ng = next_goal.lower()
    if "region-pretrain" in ng or ("region" in ng and "pretrain" in ng):
        todos.insert(
            0,
            {
                "id": "region-pretrain",
                "depends": "PoC-1",
                "title": ("PRETRAIN LatentVAE on WikiText-2 train (failing test first)"),
                "branch": "feat/agent-harness",
                "acceptance": (
                    "last_loss < first_loss on Salesforce/wikitext wikitext-2-raw-v1 train"
                ),
                "allocation": ("3090 local/code; 5080 tiny CUDA later; 1080 Ti RAG"),
                "status": "next",
            },
        )
    hb = _read_json(HEARTBEAT)
    last = hb.get("last") if isinstance(hb.get("last"), dict) else {}
    age = None
    if hb.get("t"):
        age = time.time() - float(hb.get("t") or 0)
    cluster = hb.get("cluster") if isinstance(hb.get("cluster"), dict) else {}
    mailbox = hb.get("need_grok") if isinstance(hb.get("need_grok"), dict) else {}
    heartbeat = {
        "t": hb.get("t"),
        "pid": hb.get("pid"),
        "wt": hb.get("wt"),
        "age_s": age,
        "live": bool(age is not None and age < 90),
        "identity": hb.get("identity") or "autodev",
        "next_goal": str(hb.get("next_goal") or next_goal),
        "ti": hb.get("ti"),
        "cluster": cluster,
        "need_grok": mailbox or load_need_grok(),
        "last": {
            "ok": last.get("ok"),
            "goal": str(last.get("goal") or "")[:240],
            "error": _last_error(last, {}),
            "applied": last.get("applied") if isinstance(last.get("applied"), dict) else {},
            "skipped": last.get("skipped"),
        },
    }
    return {
        "ok": bool(phase1),
        "next_goal": next_goal,
        "steer": steer,
        "notes": notes,
        "reasoning": reasoning,
        "heartbeat": heartbeat,
        "phase1": phase1,
        "todos": todos,
        "source": {
            "board": "docs/program/PHASE-1-TASK-BOARD.md",
            "steer": str(STEER),
            "heartbeat": str(HEARTBEAT),
            "scale_ladder": "docs/program/CSD-SCALE-LADDER.md",
        },
        "scale_ladder": load_scale_ladder(),
        "hf": hf_autodev_gap(),
        "grok_need": load_need_grok(),
    }


def handle_lab(method: str, path: str, payload: dict) -> tuple[int, dict] | None:  # noqa: PLR0911
    """Lab JSON routes wrapping existing CLIs. None = not a wrap route."""
    if len(path) > 1:
        path = path.rstrip("/")
    if path == "/api/gpu":
        return 200, lab_gpu(refresh=bool(payload.get("refresh")))
    if path == "/api/gpu/lock":
        return 200, lab_gpu_lock()
    if path == "/api/git":
        if method != "POST":
            return 405, {"ok": False, "rc": 405, "stdout": "POST args"}
        args = payload.get("args") if isinstance(payload.get("args"), list) else []
        return 200, lab_git(args)
    if path == "/api/loop":
        if method != "POST":
            return 405, {"ok": False, "rc": 405, "out": "POST mode"}
        return 200, lab_loop(str(payload.get("mode") or ""))
    if path == "/api/priority":
        return 200, lab_priority(str(payload.get("action") or "status"))
    if path == "/api/steer":
        if method == "GET":
            return 200, _read_json(STEER)
        if method == "POST":
            return 200, write_steer(**payload)
        return 405, {"ok": False, "error": "GET or POST"}
    if path == "/api/goals":
        return 200, lab_goals()
    if path in ("/api/grok-need", "/api/need-grok"):
        if method == "GET":
            return 200, load_need_grok()
        if method == "POST":
            return 200, write_need_grok_mailbox(payload)
        return 405, {"ok": False, "error": "GET or POST", "hosted_grok": False}
    if path == "/metrics":
        return 200, {"ok": True, "exposition": lab_metrics()}
    if path == "/api/forgejo/whoami":
        return 200, lab_forgejo("whoami", payload)
    if path == "/api/forgejo/prs":
        return 200, lab_forgejo("prs", payload)
    if path == "/api/forgejo/pr-create":
        if method != "POST":
            return 405, {"http": 405, "error": "POST"}
        return 200, lab_forgejo("pr-create", payload)
    if path == "/api/forgejo/status":
        return 200, lab_forgejo("status", payload)
    if path == "/api/forgejo/wait":
        return 200, lab_forgejo("wait", payload)
    if path == "/api/forgejo/comment":
        if method != "POST":
            return 405, {"http": 405, "ok": False}
        return 200, lab_forgejo("comment", payload)
    if path == "/api/forgejo/merge-gate":
        if method != "POST":
            return 405, {
                "ok": False,
                "state": "error",
                "merged": False,
                "notes": "POST",
            }
        return 200, lab_forgejo("merge-gate", payload)
    return None


def lab_bind() -> str:
    """LAN bind only. Why: never expose the lab agent on WAN 0.0.0.0."""
    bind = os.environ.get("CSD_LAB_BIND", "192.168.1.98")
    if bind in WAN_BINDS:
        raise SystemExit("refusing WAN bind 0.0.0.0")
    return bind


def spawn_alias(alias: str, why: str) -> dict:
    """Stand a catalog alias on 3090 or 5080 without dual 14B."""
    router = Path(__file__).resolve().parents[1] / "scripts/csd-model-router"
    p = subprocess.run(
        [str(router), "request", "--alias", alias, "--why", why, "--noping"],
        capture_output=True,
        text=True,
        check=False,
        timeout=60,
    )
    try:
        rec = json.loads(p.stdout or "{}")
    except json.JSONDecodeError:
        rec = {"ok": False, "error": (p.stdout or p.stderr or "")[:400]}
    rec["rc"] = p.returncode
    return rec


def comfy_tool(cmd: str, payload: dict | None = None) -> dict:
    """Lab JSON wrap of scripts/csd-comfy. Fail-closed when masked."""
    script = Path(__file__).resolve().parent / "csd-comfy"
    p = subprocess.run(
        [str(script), cmd],
        input=json.dumps(payload or {}),
        capture_output=True,
        text=True,
        check=False,
        timeout=45,
    )
    try:
        rec = json.loads(p.stdout or "{}")
    except json.JSONDecodeError:
        rec = {"ok": False, "notes": (p.stderr or p.stdout or "bad json")[:400]}
    if not isinstance(rec, dict):
        return {"ok": False, "notes": "bad json"}
    return rec


def chat(prompt: str) -> str:
    body = json.dumps(
        {
            "model": "local/code",
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": 512,
            "temperature": 0.2,
        }
    ).encode()
    req = urllib.request.Request(
        f"{LOCALAI}/v1/chat/completions",
        data=body,
        headers={
            "Content-Type": "application/json",
            **({"Authorization": f"Bearer {localai_key()}"} if localai_key() else {}),
        },
    )
    with urllib.request.urlopen(req, timeout=180) as resp:
        data = json.load(resp)
    text = str(((data.get("choices") or [{}])[0].get("message") or {}).get("content") or "")
    append_chat(prompt, text, "local/code")
    return text


def proxy_upstream(
    method: str,
    path_qs: str,
    body: bytes | None = None,
    extra_headers: dict | None = None,
) -> tuple[int, bytes]:
    """Homelab UI → prime GPU agent. Why: cards are inference providers only."""
    headers = dict(extra_headers or {})
    if body is not None:
        headers.setdefault("Content-Type", "application/json")
    req = urllib.request.Request(
        UPSTREAM + path_qs,
        data=body,
        method=method,
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read()
    except OSError as exc:
        return 502, json.dumps({"error": "prime agent down", "detail": str(exc)[:200]}).encode()


def serve(port: int) -> None:
    class H(BaseHTTPRequestHandler):
        def log_message(self, fmt: str, *args: object) -> None:
            return

        def _send(self, code: int, raw: bytes, ctype: str = "application/json") -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_GET(self) -> None:  # noqa: PLR0911
            path = urlparse(self.path).path
            if path in ("/", "/lab", "/lab/", "/goals", "/lab/goals", "/todos", "/lab/todos"):
                body = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            parsed = urlparse(self.path)
            apipath = parsed.path[4:] if parsed.path.startswith("/lab/") else parsed.path
            if apipath in ("/metrics", "/api/metrics"):
                self._send(
                    200,
                    lab_metrics().encode(),
                    "text/plain; version=0.0.4; charset=utf-8",
                )
                return
            if UPSTREAM and apipath.startswith("/api/"):
                qs = parsed.path + (("?" + parsed.query) if parsed.query else "")
                extra = {}
                if self.headers.get("Authorization"):
                    extra["Authorization"] = self.headers.get("Authorization") or ""
                code, raw = proxy_upstream("GET", qs, extra_headers=extra)
                self._send(code, raw)
                return
            if apipath.startswith("/api/status"):
                raw = json.dumps(snapshot()).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)
                return
            if apipath.startswith("/api/sessions"):
                q = parse_qs(parsed.query)
                sid = (q.get("id") or [""])[0]
                body = load_session(sid) if sid else {"sessions": list_sessions()}
                raw = json.dumps(body).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)
                return
            if apipath.startswith("/api/comfy/list-workflows"):
                q = parse_qs(parsed.query)
                src = (q.get("source") or ["catalog"])[0]
                rec = comfy_tool("list-workflows", {"source": src})
                self._send(200, json.dumps(rec).encode())
                return
            if apipath.startswith("/api/comfy/prompt-status"):
                q = parse_qs(parsed.query)
                pid = (q.get("prompt_id") or [""])[0]
                rec = comfy_tool("prompt-status", {"prompt_id": pid})
                self._send(200, json.dumps(rec).encode())
                return
            hit = handle_lab("GET", apipath, _qs_payload(parsed.query))
            if hit is not None:
                code, rec = hit
                self._send(code, json.dumps(rec).encode())
                return
            self.send_error(404)

        def do_POST(self) -> None:
            n = int(self.headers.get("Content-Length") or "0")
            raw_in = self.rfile.read(n)
            postpath = urlparse(self.path).path
            if postpath.startswith("/lab/"):
                postpath = postpath[4:]
            if UPSTREAM and postpath.startswith("/api/"):
                extra = {}
                if self.headers.get("Authorization"):
                    extra["Authorization"] = self.headers.get("Authorization") or ""
                code, raw = proxy_upstream("POST", postpath, raw_in, extra_headers=extra)
                self._send(code, raw)
                return
            payload = json.loads(raw_in or b"{}")
            if postpath == "/api/apply":
                if not check_apply_auth(self.headers.get("Authorization") or ""):
                    self._send(401, b'{"error":"unauthorized"}')
                    return
                rec = http_apply(
                    str(payload.get("worktree") or ""),
                    str(payload.get("path") or ""),
                    str(payload.get("content") or ""),
                )
                raw = json.dumps(rec).encode()
                self._send(200 if rec.get("ok") else 400, raw)
                return
            if not isinstance(payload, dict):
                payload = {}
            hit = handle_lab("POST", postpath, payload)
            if hit is not None:
                code, rec = hit
                self._send(code, json.dumps(rec).encode())
                return
            if postpath == "/api/steer":
                raw = json.dumps(write_steer(**payload)).encode()
            elif postpath == "/api/spawn":
                raw = json.dumps(
                    spawn_alias(
                        str(payload.get("alias") or "local/code"), str(payload.get("why") or "lab")
                    )
                ).encode()
            elif postpath == "/api/chat":
                text = chat(str(payload.get("prompt") or ""))
                raw = json.dumps({"content": text}).encode()
            elif postpath == "/api/comfy/list-workflows":
                raw = json.dumps(comfy_tool("list-workflows", payload)).encode()
            elif postpath == "/api/comfy/queue-prompt":
                raw = json.dumps(comfy_tool("queue-prompt", payload)).encode()
            elif postpath == "/api/comfy/prompt-status":
                raw = json.dumps(comfy_tool("prompt-status", payload)).encode()
            elif postpath == "/api/comfy/flux-klein-4b":
                raw = json.dumps(comfy_tool("flux-klein-4b", payload)).encode()
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

    bind = lab_bind()
    httpd = ThreadingHTTPServer((bind, port), H)
    print(f"csd-lab-console http://{bind}:{port}/lab")
    httpd.serve_forever()


